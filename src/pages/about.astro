---
import AppCTA from '../components/AppCTA.astro';
import Base from '../layouts/Base.astro';
import { vocab, units } from '../lib/learn';
import { siteUrl } from '../lib/site';

const title = 'About Bol Marathi';
const description = 'Bol Marathi is an independent Marathi-learning product: a free learning website plus a practice app with listening, speaking and spaced repetition.';
---

<Base title={title} description={description}>
	<div class="prose">
		<p class="kicker">About</p>
		<h1>About Bol Marathi</h1>
		<p class="lede">
			Bol Marathi is an independent Marathi-learning product made for people
			learning Marathi through Hindi or English.
		</p>
		<h2>What exists today</h2>
		<ul>
			<li>This free website: {vocab.length} words, {units.length * 6} lessons, phrases, grammar — no signup.</li>
			<li>The Bol Marathi Android app (in closed testing): listening, speaking, sentence building, spaced repetition, streaks.</li>
		</ul>
		<h2>Who makes it</h2>
		<p>
			An independent developer building in the open. The curriculum lives in
			the app repository and is published here through an auditable sync —
			see <a href={siteUrl('/how-it-works/')}>how the curriculum works</a>.
			Linguistic review status is tracked in the language QA report.
		</p>
		<h2>Contact</h2>
		<p>Questions, corrections, native-speaker review offers: <a href={siteUrl('/contact/')}>contact page</a>.</p>
		<AppCTA variant="general" context="about" />
	</div>
</Base>
