---
import AppCTA from '../components/AppCTA.astro';
import Base from '../layouts/Base.astro';
import JsonLd from '../components/JsonLd.astro';
import Mascot from '../components/Mascot.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import { BOL_MARATHI_APP } from '../data/app';
import { clusters, phraseSets, grammarTopics, units, vocab } from '../lib/learn';
import { pageArt, pageLQIP } from '../lib/art';
import { siteUrl } from '../lib/site';

const homeUrl = new URL(import.meta.env.BASE_URL, Astro.site).toString();
const sections = [
	{ kicker: 'Vocabulary', title: 'Words grouped the way you use them', href: siteUrl('/vocabulary/'), items: clusters.map((c) => ({ label: c.title, href: siteUrl(`/vocabulary/${c.slug}/`), art: pageArt(`vocabulary/${c.slug}`), lqip: pageLQIP(`vocabulary/${c.slug}`) })) },
	{ kicker: 'Phrases', title: 'Say it in Marathi', href: siteUrl('/phrases/'), items: phraseSets.map((p) => ({ label: p.title, href: siteUrl(`/phrases/${p.slug}/`), art: pageArt(`phrases/${p.slug}`), lqip: pageLQIP(`phrases/${p.slug}`) })) },
	{ kicker: 'Grammar', title: 'Patterns, not rules', href: siteUrl('/grammar/'), items: grammarTopics.map((g) => ({ label: g.title, href: siteUrl(`/grammar/${g.slug}/`), art: pageArt(`grammar/${g.slug}`), lqip: pageLQIP(`grammar/${g.slug}`) })) },
];

const paths = [
	{ href: siteUrl('/start/'), label: 'New to Marathi? Start here', desc: 'Six steps: words → greetings → sentences → bridges → your first lesson.', art: pageArt('start'), lqip: pageLQIP('start') },
	{ href: siteUrl('/hindi-to-marathi/'), label: 'Learn from Hindi', desc: 'Word pairs and sentence bridges mapped from Hindi you already know.', art: pageArt('hindi-to-marathi'), lqip: pageLQIP('hindi-to-marathi') },
	{ href: siteUrl('/english-to-marathi/'), label: 'Learn from English', desc: 'Everyday words and sentences with English meanings and pronunciation.', art: pageArt('english-to-marathi'), lqip: pageLQIP('english-to-marathi') },
	{ href: siteUrl('/hi/'), label: 'हिंदी में सीखें', desc: 'पूरा शुरुआती खंड हिंदी में — शब्द, वाक्य और ऐप।', art: pageArt('hi'), lqip: pageLQIP('hi'), lang: 'hi' },
	{ href: siteUrl('/quiz/'), label: 'Test yourself', desc: '10-question quizzes with instant feedback.', art: pageArt('quiz'), lqip: pageLQIP('quiz') },
	{ href: siteUrl('/downloads/'), label: 'Free Anki decks', desc: 'Top 100 words or the full 1002-word set.', art: pageArt('downloads'), lqip: pageLQIP('downloads') },
];

const popular = [
	{ href: siteUrl('/marathi-numbers/'), label: 'Numbers 1–20', desc: 'Count, prices and time.', art: pageArt('marathi-numbers'), lqip: pageLQIP('marathi-numbers') },
	{ href: siteUrl('/marathi-days-months/'), label: 'Days & months', desc: 'Weeks, months, parts of day.', art: pageArt('marathi-days-months'), lqip: pageLQIP('marathi-days-months') },
	{ href: siteUrl('/marathi-pronunciation/'), label: 'Pronunciation', desc: 'Sounds Hindi speakers must learn.', art: pageArt('marathi-pronunciation'), lqip: pageLQIP('marathi-pronunciation') },
];

const method = [
	{ n: '1 · Learn', title: 'Read real words', body: 'Words and sentences from the curriculum — every one with Hindi and English meanings.', href: siteUrl('/vocabulary/'), cta: 'Browse vocabulary' },
	{ n: '2 · Practice', title: 'Say it, test it', body: 'Listen to each word, say it aloud, take a 10-question quiz with instant feedback.', href: siteUrl('/quiz/'), cta: 'Take a quiz' },
	{ n: '3 · Remember', title: 'Review before you forget', body: 'Weakest-word-first practice and spaced repetition — the app\u2019s review loop.', href: siteUrl('/app/'), cta: 'See the practice loop' },
];

const faqs = [
	{ q: 'Can I learn Marathi from Hindi?', a: 'Yes — start with Hindi → Marathi words and sentence bridges, which map each Hindi pattern onto Marathi word by word.' },
	{ q: 'Can I learn Marathi from English?', a: 'Yes — every word and lesson carries English meanings, and there is a dedicated English → Marathi section.' },
	{ q: 'Is Bol Marathi free?', a: `All ${vocab.length} words and ${units.length * 6} lessons on this site are free. App pricing will be announced at launch.` },
	{ q: 'How many lessons are there?', a: `${units.length} units and ${units.length * 6} lessons, from Marathi Fundamentals to a final assessment.` },
	{ q: 'Does Bol Marathi teach speaking?', a: 'The website teaches reading knowledge; the app adds listening, speaking checks, sentence building and spaced repetition.' },
	{ q: 'How is the app different from this website?', a: 'The website gives you the knowledge. The app gives you the practice loop — listen, speak, build, review, remember — plus streaks, XP and weakest-word recommendations.' },
];
---

<Base title="Learn Marathi from Hindi or English | Bol Marathi" description={SITE_DESCRIPTION} alternates={[{ lang: 'x-default', href: siteUrl('/') }, { lang: 'en', href: siteUrl('/') }, { lang: 'hi', href: siteUrl('/hi/') }]}>
	<JsonLd
		headline={SITE_TITLE}
		description={SITE_DESCRIPTION}
		url={homeUrl}
		type="WebPage"
		breadcrumbs={[]}
	/>
	<JsonLd
		headline="Learn Marathi — frequently asked questions"
		description="Answers about learning Marathi from Hindi or English with Bol Marathi."
		url={homeUrl}
		type="FAQPage"
		faq={faqs.map((f) => ({ question: f.q, answer: f.a }))}
		breadcrumbs={[]}
	/>
	<div class="prose">
		<p class="kicker">Bol Marathi · Learn Marathi</p>
		<div class="hero-row">
			<div class="hero-text">
				<h1>Learn Marathi from Hindi or English.</h1>
				<p class="lede">
					Build practical Marathi vocabulary, understand everyday phrases, and
					practice listening, speaking and sentence building — from the real
					Bol Marathi curriculum of {units.length} units and {vocab.length} words.
				</p>
				<div class="hub-cta">
					<a class="btn" href={siteUrl('/start/')} data-funnel="path_click">Start Learning Free</a>
					<a class="btn ghost" href={siteUrl('/lessons/')} data-funnel="path_click">Explore {units.length * 6} Lessons</a>
				</div>
			</div>
			<div class="hero-mascot">
				<Mascot pose="wave" size="lg" ariaLabel="Mascot welcoming you to learn Marathi" />
			</div>
		</div>
		<ul class="stat-strip" aria-label="Free content included">
			<li><strong>{units.length}</strong> units</li>
			<li><strong>{units.length * 6}</strong> lessons</li>
			<li><strong>{vocab.length.toLocaleString('en-IN')}</strong> words</li>
			<li class="stat-free"><strong>Free</strong> no signup</li>
		</ul>
		<p class="byline">Curated by Bol Marathi · <a href={siteUrl('/how-it-works/')}>how the curriculum works</a></p>
	</div>

	<section>
		<div class="section-head">
			<div>
				<p class="kicker">Choose your path</p>
				<h2>How do you want to learn?</h2>
			</div>
		</div>
		<ul class="card-grid">
			{paths.map((p, i) => (
				<li class={`reveal reveal-delay-${i + 1}`}>
					<a class="card" href={p.href} data-funnel="path_click" lang={p.lang}>
						<img src={p.art} alt="" loading="lazy" width="1200" height="630" style={`background-image: url('${p.lqip}'); background-size: cover;`} onload="this.style.backgroundImage=''" />
						<h3>{p.label}</h3>
						<p>{p.desc}</p>
					</a>
				</li>
			))}
		</ul>
	</section>

	<section>
		<div class="section-head">
			<div>
				<p class="kicker">The method</p>
				<h2>Learn → Practice → Remember</h2>
			</div>
		</div>
		<ul class="card-grid method-grid">
			{method.map((m, i) => (
				<li class={`reveal reveal-delay-${i + 1}`}>
					<a class="card" href={m.href} data-funnel="method_click">
						<p class="kicker">{m.n}</p>
						<h3>{m.title}</h3>
						<p>{m.body}</p>
						<span class="method-cta">{m.cta} &rarr;</span>
					</a>
				</li>
			))}
		</ul>
	</section>

	<section>
		<div class="section-head">
			<div>
				<p class="kicker">Who is it for</p>
				<h2>Learning Marathi? Start from your language.</h2>
			</div>
		</div>
		<div class="prose">
			<ul class="why">
				<li><strong>Hindi speakers</strong> — map Hindi patterns onto Marathi word by word.</li>
				<li><strong>English speakers</strong> — every word and lesson carries English meanings.</li>
				<li><strong>Beginners</strong> — greetings, first words, first sentences, zero assumed knowledge.</li>
				<li><strong>Travellers</strong> — travel, shopping and restaurant-ready phrases.</li>
				<li><strong>Living or working in Maharashtra</strong> — daily conversation, workplace words, real lessons.</li>
			</ul>
		</div>
	</section>

	<section>
		<div class="section-head">
			<div>
				<p class="kicker">Popular right now</p>
				<h2>Marathi learners start here</h2>
			</div>
		</div>
		<ul class="card-grid">
			{popular.map((p, i) => (
				<li class={`reveal reveal-delay-${i + 1}`}>
					<a class="card" href={p.href}>
						<img src={p.art} alt="" loading="lazy" width="1200" height="630" style={`background-image: url('${p.lqip}'); background-size: cover;`} onload="this.style.backgroundImage=''" />
						<h3>{p.label}</h3>
						<p>{p.desc}</p>
					</a>
				</li>
			))}
		</ul>
	</section>

	{sections.map((s) => (
		<section>
			<div class="section-head">
				<div>
					<p class="kicker">{s.kicker}</p>
					<h2>{s.title}</h2>
				</div>
				<a href={s.href}>All &rarr;</a>
			</div>
			<ul class="card-grid">
				{s.items.map((i, idx) => (
					<li class={`reveal reveal-delay-${(idx % 6) + 1}`}>
						<a class="card" href={i.href}>
							<img src={i.art} alt="" loading="lazy" width="1200" height="630" style={`background-image: url('${i.lqip}'); background-size: cover;`} onload="this.style.backgroundImage=''" />
							<h3>{i.label}</h3>
						</a>
					</li>
				))}
			</ul>
		</section>
	))}

	<section>
		<div class="section-head">
			<div>
				<p class="kicker">Why Bol Marathi</p>
				<h2>Reading teaches. Practice makes it stick.</h2>
			</div>
			<a href={siteUrl('/app/')}>The app &rarr;</a>
		</div>
		<div class="prose">
			<ul class="why">
				<li><strong>Weakest words first</strong> — recommendations target what you keep forgetting.</li>
				<li><strong>Review before you forget</strong> — scheduled repetition with recall tracking.</li>
				<li><strong>Listen and speak</strong> — quizzes, mic checks and Marathi voice setup.</li>
				<li><strong>Build sentences</strong> — arrange words into correct Marathi order.</li>
				<li><strong>Stay consistent</strong> — streaks, XP, levels and reminders.</li>
			</ul>
		</div>
	</section>

	<section>
		<div class="section-head">
			<div>
				<p class="kicker">Why trust this</p>
				<h2>One curriculum, audited and open</h2>
			</div>
			<a href={siteUrl('/how-it-works/')}>Methodology &rarr;</a>
		</div>
		<div class="prose">
			<p>
				Every page here comes from the same {units.length}-unit Bol Marathi
				curriculum ({vocab.length} words) — synced, versioned and
				language-checked, never invented for the web. The website teaches
				reading knowledge; the app adds the practice loop.
			</p>
		</div>
	</section>

	<section>
		<div class="section-head">
			<div>
				<p class="kicker">Lessons</p>
				<h2>Follow the curriculum</h2>
			</div>
			<a href={siteUrl('/lessons/')}>All {units.length} units &rarr;</a>
		</div>
		<ul class="card-grid">
			{units.slice(0, 6).map((u) => (
				<li>
					<a class="card" href={siteUrl(`/lessons/${u.unit}/`)}>
						<img src={pageArt(`lessons/${u.unit}`)} alt="" loading="lazy" width="1200" height="630" />
						<h3>Unit {u.unit} — {u.titleEn}</h3>
						<p>{u.goalsEn.slice(0, 2).join(' · ')}</p>
					</a>
				</li>
			))}
		</ul>
	</section>

	<section>
		<div class="section-head">
			<div>
				<p class="kicker">FAQ</p>
				<h2>Common questions</h2>
			</div>
		</div>
		<div class="prose">
			{faqs.map((f) => (
				<details>
					<summary>{f.q}</summary>
					<p>{f.a}</p>
				</details>
			))}
		</div>
	</section>

	<div class="prose">
		<AppCTA variant="general" context="hub" />
	</div>
</Base>

<style>
	.hero-row {
		display: flex;
		align-items: flex-start;
		justify-content: space-between;
		gap: 2rem;
		flex-wrap: wrap;
		margin: 1.5rem 0 1rem 0;
	}
	.hero-text { flex: 1; min-width: 280px; }
	.hero-mascot {
		flex-shrink: 0;
		align-self: flex-start;
	}
	.hero-mascot .mascot-svg {
		animation: mascot-wave 2s ease-in-out infinite;
	}
	@media (max-width: 760px) {
		.hero-row { flex-direction: column; align-items: center; text-align: center; }
		.hero-mascot { order: -1; margin-bottom: 1rem; }
		.hero-text h1 { font-size: 1.75rem; }
	}
	@media (prefers-reduced-motion: reduce) {
		.hero-mascot .mascot-svg { animation: none; }
	}

	.hub-cta { display: flex; flex-wrap: wrap; gap: 0.75em; margin: 1.5em 0 0.5em 0; }
	.hub-cta .btn {
		display: inline-block;
		min-height: 52px;
		line-height: 52px;
		padding: 0 1.5em;
		background: var(--accent);
		color: #fff;
		font-size: 0.95rem;
		font-weight: 600;
		text-decoration: none;
		border-radius: var(--radius);
	}
	.hub-cta .btn:hover { background: var(--accent); filter: brightness(0.92); color: #fff; }
	.hub-cta .btn.ghost {
		background: transparent;
		color: var(--accent);
		border: var(--border);
		line-height: 50px;
	}
	.byline { font-size: 0.85rem; color: rgb(var(--gray)); }
	.stat-strip {
		list-style: none;
		display: flex;
		flex-wrap: wrap;
		gap: 0.5em 1.5em;
		margin: 1.25em 0 0.75em 0;
		padding: 0.75em 1.25em;
		border: var(--border);
		border-radius: var(--radius);
		background: var(--accent-fixed);
		width: fit-content;
		max-width: 100%;
	}
	.stat-strip li {
		font-size: 0.88rem;
		color: var(--accent-on-fixed);
		white-space: nowrap;
	}
	.stat-strip strong { font-size: 1.05rem; font-weight: 700; }
	.stat-strip li + li { border-left: 1px solid rgb(195 79 44 / 0.35); padding-left: 1.5em; }
	.method-grid { grid-template-columns: repeat(3, 1fr); }
	@media (max-width: 860px) {
		.method-grid { grid-template-columns: 1fr; }
	}
	.method-grid .card .kicker { margin-bottom: 0.3em; }
	.method-cta {
		display: inline-block;
		margin-top: 0.4em;
		font-size: 0.88rem;
		font-weight: 600;
		color: var(--accent);
	}
	.method-grid .card:hover .method-cta { color: var(--accent-container); }
	section { margin-top: var(--space-5); }
	.section-head {
		display: flex;
		justify-content: space-between;
		align-items: baseline;
		gap: 1em;
		border-bottom: var(--border);
		padding-bottom: 0.5em;
		margin-bottom: 0.25em;
	}
	.section-head h2 { font-size: 1.4rem; margin: 0; }
	.section-head a { font-size: 0.9rem; white-space: nowrap; }
	.card-grid h3 { font-size: 1.05rem; }
	.why { padding-left: 1.2em; }
	.why li { margin-bottom: 0.5em; }
	details {
		border: var(--border);
		border-radius: var(--radius);
		background: var(--card);
		padding: 0.9em 1.1em;
		margin-bottom: 0.6em;
	}
	details summary {
		font-weight: 600;
		cursor: pointer;
	}
	details p { margin: 0.6em 0 0.2em 0; }
</style>
