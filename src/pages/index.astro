---
// Premium Homepage — Bol Marathi
// "A premium Marathi-learning product that happens to have an excellent SEO content library."

import Base from '../layouts/Base.astro';
import JsonLd from '../components/JsonLd.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import { clusters, phraseSets, grammarTopics, units, vocab } from '../lib/learn';
import { pageArt, pageLQIP } from '../lib/art';
import { siteUrl } from '../lib/site';

// Premium Components
import PremiumHero from '../components/layout/PremiumHero.astro';
import LearningPath from '../components/layout/LearningPath.astro';
import EntryPoints from '../components/layout/EntryPoints.astro';
import RelatedLessons from '../components/layout/RelatedLessons.astro';
import PracticeCTA from '../components/learning/PracticeCTA.astro';

const homeUrl = new URL(import.meta.env.BASE_URL, Astro.site).toString();

// Entry points data
const entryPoints = [
  {
    id: 'english',
    label: 'I speak English',
    sublabel: 'English → Marathi',
    desc: 'Everyday words and sentences with English meanings, pronunciation, and examples.',
    href: siteUrl('/english-to-marathi/'),
  },
  {
    id: 'hindi',
    label: 'I speak Hindi',
    sublabel: 'हिंदी → मराठी',
    desc: 'Word pairs and sentence bridges mapped from Hindi you already know.',
    href: siteUrl('/hindi-to-marathi/'),
  },
  {
    id: 'continue',
    label: 'I know some Marathi',
    sublabel: 'Continue learning',
    desc: 'Practice, review, and advance with quizzes, spaced repetition, and lessons.',
    href: siteUrl('/start/'),
  },
];

// How do you want to learn cards
const learnPaths = [
  {
    id: 'new',
    label: 'New to Marathi?',
    sublabel: 'Start here',
    desc: 'Six steps: words → greetings → sentences → bridges → your first lesson.',
    href: siteUrl('/start/'),
    icon: '🌱',
  },
  {
    id: 'quiz',
    label: 'Test yourself',
    sublabel: 'Take a quiz',
    desc: '10-question quizzes with instant feedback.',
    href: siteUrl('/quiz/'),
    icon: '❓',
  },
  {
    id: 'anki',
    label: 'Free Anki decks',
    sublabel: 'Download decks',
    desc: 'Top 100 words or the full 1002-word set.',
    href: siteUrl('/downloads/'),
    icon: '📦',
  },
];
// Method cards
const methodSteps = [
  {
    n: '1',
    title: 'Learn',
    body: 'Read real words and sentences from the curriculum — every one with Hindi and English meanings, audio pronunciation, and examples.',
    href: siteUrl('/vocabulary/'),
    cta: 'Browse vocabulary →',
  },
  {
    n: '2',
    title: 'Practice',
    body: 'Listen to each word, say it aloud, flip cards to test recall, take 10-question quizzes with instant feedback.',
    href: siteUrl('/quiz/'),
    cta: 'Take a quiz →',
  },
    {
      n: '3',
      title: 'Remember',
      body: 'Weakest-word-first practice and spaced repetition — the app\'s review loop makes it stick.',
      href: siteUrl('/review/'),
      cta: 'Start reviewing →',
    },
  ];

// Featured topics (curated from clusters)
const featuredVocab = clusters.slice(0, 4).map(c => ({
  slug: siteUrl(`/vocabulary/${c.slug}/`),
  title: c.title,
  family: 'Vocabulary',
  description: c.description?.slice(0, 120) + '...',
  art: pageArt(`vocabulary/${c.slug}`),
  lqip: pageLQIP(`vocabulary/${c.slug}`),
}));

const featuredPhrases = phraseSets.slice(0, 4).map(p => ({
  slug: siteUrl(`/phrases/${p.slug}/`),
  title: p.title,
  family: 'Phrases',
  description: p.description?.slice(0, 120) + '...',
  art: pageArt(`phrases/${p.slug}`),
  lqip: pageLQIP(`phrases/${p.slug}`),
}));

const featuredGrammar = grammarTopics.slice(0, 4).map(g => ({
  slug: siteUrl(`/grammar/${g.slug}/`),
  title: g.title,
  family: 'Grammar',
  description: g.description?.slice(0, 120) + '...',
  art: pageArt(`grammar/${g.slug}`),
  lqip: pageLQIP(`grammar/${g.slug}`),
}));

const allFeatured = [...featuredVocab, ...featuredPhrases, ...featuredGrammar];

// FAQ data
const faqs = [
  { q: 'Can I learn Marathi from Hindi?', a: 'Yes — start with Hindi → Marathi words and sentence bridges, which map each Hindi pattern onto Marathi word by word.' },
  { q: 'Can I learn Marathi from English?', a: 'Yes — every word and lesson carries English meanings, and there is a dedicated English → Marathi section.' },
  { q: 'Is Bol Marathi free?', a: `All ${vocab.length} words and ${units.length * 6} lessons on this site are free. App pricing will be announced at launch.` },
  { q: 'How many lessons are there?', a: `${units.length} units and ${units.length * 6} lessons, from Marathi Fundamentals to a final assessment.` },
  { q: 'Does Bol Marathi teach speaking?', a: 'The website teaches reading knowledge; the app adds listening, speaking checks, sentence building and spaced repetition.' },
  { q: 'How is the app different from this website?', a: 'The website gives you the knowledge. The app gives you the practice loop — listen, speak, build, review, remember — plus streaks, XP and weakest-word recommendations.' },
];
---

<Base
  title={SITE_TITLE}
  description={SITE_DESCRIPTION}
  alternates={[
    { lang: 'x-default', href: siteUrl('/') },
    { lang: 'en', href: siteUrl('/') },
    { lang: 'hi', href: siteUrl('/hi/') }
  ]}
>
  <JsonLd
    headline={SITE_TITLE}
    description={SITE_DESCRIPTION}
    url={homeUrl}
    type="WebPage"
    breadcrumbs={[]}
  />
  <JsonLd
    headline="Learn Marathi — frequently asked questions"
    description="Answers about learning Marathi from Hindi or English with Bol Marathi."
    url={homeUrl}
    type="FAQPage"
    faq={faqs.map(f => ({ question: f.q, answer: f.a }))}
    breadcrumbs={[]}
  />

  <!-- HERO (full width) -->
  <PremiumHero
    kicker="Bol Marathi · Learn Marathi"
    title="नमस्कार 👋  Learn Marathi for real conversations."
    subtitle="From your first word to confident dialogue. Learn from English or Hindi with the complete Bol Marathi curriculum — 26 units, 156 lessons, 1000+ words. Free, no signup required."
    primaryCTA={{ label: 'Start Learning Free', href: siteUrl('/start/') }}
    secondaryCTA={{ label: 'Explore All Lessons', href: siteUrl('/lessons/') }}
    stats={[
      { value: String(units.length), label: 'Units' },
      { value: String(units.length * 6), label: 'Lessons' },
      { value: vocab.length.toLocaleString('en-IN'), label: 'Words' },
      { value: 'Free', label: 'No signup' },
    ]}
  />

  <!-- LEARNING PATH (full width) -->
    <div class="section-spacing-full">
      <LearningPath currentStep={0} className="animate-in" />
    </div>

    <!-- HOW DO YOU WANT TO LEARN (full width) - NEW SECTION -->
    <section aria-labelledby="learn-paths-title" class="section-spacing-full">
      <div class="container-wide">
        <header class="section-head">
          <div>
            <p class="kicker">Choose your path</p>
            <h2 id="learn-paths-title">How do you want to learn?</h2>
          </div>
        </header>
        <ul class="card-grid animate-in">
          {learnPaths.map((path, i) => (
            <li class={`reveal reveal-delay-${i + 1}`}>
              <a class="card interactive hover-float" href={path.href} data-funnel="path_click" data-path={path.id}>
                <div class="path-icon" style="background: var(--color-primary-fixed); color: var(--color-primary);">
                  {path.icon}
                </div>
                <span class="path-sublabel">{path.sublabel}</span>
                <h3>{path.label}</h3>
                <p>{path.desc}</p>
                <span class="path-arrow" aria-hidden="true">→</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- ENTRY POINTS (full width) -->
    <div class="section-spacing-full">
      <EntryPoints className="animate-in" />
    </div>

    <!-- METHOD (full width) -->
    <section class="method-section section-spacing-full" aria-labelledby="method-title">
    <div class="container-wide">
      <header class="section-head">
        <div>
          <p class="kicker">The Method</p>
          <h2 id="method-title">Learn → Practice → Remember</h2>
        </div>
      </header>
      <ul class="card-grid method-grid animate-in">
        {methodSteps.map((m, i) => (
          <li class={`reveal reveal-delay-${i + 1}`}>
            <a class="card interactive hover-float" href={m.href} data-funnel="method_click">
              <p class="kicker">{m.n}</p>
              <h3>{m.title}</h3>
              <p>{m.body}</p>
              <span class="method-cta">{m.cta}</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- FEATURED CONTENT (full width) -->
  <section aria-labelledby="featured-title" class="section-spacing-full">
    <div class="container-wide">
      <header class="section-head">
        <div>
          <p class="kicker">Start Here</p>
          <h2 id="featured-title">Popular lessons this week</h2>
        </div>
      </header>
      <RelatedLessons links={allFeatured} max={6} title="Popular lessons" className="animate-in" />
    </div>
  </section>

  <!-- WHY BOL MARATHI (full width) -->
  <section aria-labelledby="why-title" class="section-spacing-full">
    <div class="container-wide">
      <header class="section-head">
        <div>
          <p class="kicker">Why Bol Marathi</p>
          <h2 id="why-title">Reading teaches. Practice makes it stick.</h2>
        </div>
        <a href={siteUrl('/app/')}>The app →</a>
      </header>
      <div class="prose reveal-stagger">
        <ul class="why">
          <li><strong>Weakest words first</strong> — recommendations target what you keep forgetting.</li>
          <li><strong>Review before you forget</strong> — scheduled repetition with recall tracking.</li>
          <li><strong>Listen and speak</strong> — quizzes, mic checks and Marathi voice setup.</li>
          <li><strong>Build sentences</strong> — arrange words into correct Marathi order.</li>
          <li><strong>Stay consistent</strong> — streaks, XP, levels and reminders.</li>
        </ul>
      </div>
          </div>
          </section>

          <!-- CURRICULUM TRUST (full width) -->
    <section aria-labelledby="trust-title" class="section-spacing-full">
      <div class="container-wide">
        <header class="section-head">
          <div>
            <p class="kicker">Why trust this</p>
            <h2 id="trust-title">One curriculum, audited and open</h2>
          </div>
          <a href={siteUrl('/how-it-works/')}>Methodology →</a>
        </header>
        <div class="prose reveal">
          <p>
            Every page here comes from the same {units.length}-unit Bol Marathi curriculum ({vocab.length} words) — synced, versioned and language-checked, never invented for the web. The website teaches reading knowledge; the app adds the practice loop.
          </p>
        </div>
      </div>
    </section>

    <!-- LESSONS PREVIEW (full width) -->
    <section aria-labelledby="lessons-title" class="section-spacing-full">
      <div class="container-wide">
        <header class="section-head">
          <div>
            <p class="kicker">Lessons</p>
            <h2 id="lessons-title">Follow the curriculum</h2>
          </div>
          <a href={siteUrl('/lessons/')}>All {units.length} units →</a>
        </header>
        <ul class="card-grid animate-in">
          {units.slice(0, 6).map((u) => (
            <li class="reveal">
              <a class="card interactive hover-float" href={siteUrl(`/lessons/${u.unit}/`)}>
                <img src={pageArt(`lessons/${u.unit}`)} alt="" loading="lazy" width="1200" height="630" />
                <h3>Unit {u.unit} — {u.titleEn}</h3>
                <p>{u.goalsEn.slice(0, 2).join(' · ')}</p>
              </a>
            </li>
          ))}
        </ul>
              </div>
            </section>

            <!-- FAQ (text content - keep prose) -->
    <section aria-labelledby="faq-title" class="section-spacing-full">
      <div class="container-wide">
        <header class="section-head">
          <div>
            <p class="kicker">FAQ</p>
            <h2 id="faq-title">Common questions</h2>
          </div>
        </header>
        <div class="prose">
          {faqs.map((f) => (
            <details>
              <summary>{f.q}</summary>
              <p>{f.a}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <!-- APP CTA (full width) -->
    <div class="section-spacing-full">
      <div class="container-wide">
        <PracticeCTA variant="general" context="homepage" />
      </div>
    </div>
</Base>

<script>
  // Initialize intersection observer for reveal animations
  document.addEventListener('astro:page-load', () => {
    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          entry.target.classList.add('visible');
        }
      });
    }, { rootMargin: '0px 0px -50px 0px', threshold: 0.1 });

    document.querySelectorAll('.reveal, .reveal-stagger > *').forEach(el => observer.observe(el));

    // Add animate-in classes after mount for entrance animations
    requestAnimationFrame(() => {
      document.querySelectorAll('.animate-in').forEach(el => el.classList.add('visible'));
    });
  });
</script>

<style>
  .method-grid {
    grid-template-columns: repeat(3, 1fr);
  }

  @media (max-width: 860px) {
    .method-grid { grid-template-columns: 1fr; }
  }

  .method-grid .card .kicker { margin-bottom: 0.3em; }
  .method-cta {
    display: inline-block;
    margin-top: 0.4em;
    font-size: 0.88rem;
    font-weight: 600;
    color: var(--color-primary);
  }
  .method-grid .card:hover .method-cta { color: var(--color-primary-light); }

  .section-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--space-4);
    border-bottom: 1px solid var(--color-border);
    padding-bottom: var(--space-2);
    margin-bottom: var(--space-4);
  }
  .section-head h2 { font-size: var(--text-h2); margin: 0; }
  .section-head a { font-size: var(--text-body-sm); white-space: nowrap; color: var(--color-primary); }
  .section-head a:hover { color: var(--color-primary-light); }

  .why { padding-left: 1.2em; }
  .why li { margin-bottom: var(--space-3); }

  details {
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    background: var(--color-surface);
    padding: var(--space-3) var(--space-4);
    margin-bottom: var(--space-3);
  }
  details summary {
    font-weight: 600;
    cursor: pointer;
  }
  details p { margin: var(--space-2) 0 0 0; }

  /* Prose container max-width for text content */
  .prose { max-width: var(--measure-wide); margin: 0 auto; padding: 0 var(--space-4); }

  @media (max-width: 640px) {
    .prose { padding: 0 var(--space-3); }
  }
</style>