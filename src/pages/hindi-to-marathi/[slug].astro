---
// Hindi → Marathi bridge pages (src/data/seo/hindi-bridges.json).
// Renders unit bridge rows: Hindi | Marathi | word map | grammar note.
import Learn from '../../layouts/Learn.astro';
import QuickPractice from '../../components/QuickPractice.astro';
import MistakeTable from '../../components/MistakeTable.astro';
import AppCTA from '../../components/AppCTA.astro';
import RelatedContent from '../../components/RelatedContent.astro';
import { seoPagesByFamily, bridgesForPage, relatedFor, FAMILY_BASE, FAMILY_LABEL } from '../../lib/seo';
import { siteUrl } from '../../lib/site';

export async function getStaticPaths() {
	return seoPagesByFamily('hindi-bridge').map((p) => ({ params: { slug: p.slug }, props: { page: p } }));
}

const page = Astro.props.page as import('../../lib/seo').SeoPage;
const bridges = bridgesForPage(page);
const related = relatedFor(page);
const metaBits = [
	`${bridges.length} Hindi → Marathi bridges`,
	...(page.units?.length ? [page.units.length > 1 ? `Units ${page.units.join(', ')}` : `Unit ${page.units[0]}`] : []),
];
---

<Learn
	title={page.title}
	h1={page.h1 ?? page.title}
	description={page.description}
	kicker={FAMILY_LABEL[page.family]}
	crumbs={[
		{ label: FAMILY_LABEL[page.family], href: siteUrl(FAMILY_BASE[page.family]) },
		{ label: page.title, href: siteUrl(`${FAMILY_BASE[page.family]}${page.slug}/`) },
	]}
	canonicalPath={`${FAMILY_BASE[page.family]}${page.slug}/`}
	about={[page.primaryKeyword, ...page.secondaryKeywords].join('; ')}
	meta={metaBits}
	faq={page.faq ?? []}
>
	<h2>What you will learn</h2>
	{page.intro.map((para) => <p>{para}</p>)}
	{page.tip && <p class="tip"><strong>Tip:</strong> {page.tip}</p>}

	<h2>Hindi → Marathi, line by line</h2>
	<div class="table-scroll" role="region" aria-label={page.title} tabindex="0">
		<table class="vocab">
			<thead>
				<tr>
					<th scope="col">Hindi</th>
					<th scope="col">Marathi</th>
					<th scope="col">Word map</th>
					<th scope="col">Grammar note</th>
				</tr>
			</thead>
			<tbody>
				{bridges.map((b) => (
					<tr>
						<td lang="hi">{b.hindi} <br /><small>{b.english}</small></td>
						<td class="mr" lang="mr">{b.marathi}</td>
						<td><small>{Object.entries(b.mapEn).map(([k, v]) => `${k} → ${v}`).join('; ')}</small></td>
						<td>{b.grammarEn}</td>
					</tr>
				))}
			</tbody>
		</table>
	</div>

	{(page.sections ?? []).map((s) => (
		<section>
			<h2>{s.heading}</h2>
			{s.paragraphs.map((para) => <p>{para}</p>)}
		</section>
	))}

	<MistakeTable mistakes={page.mistakes ?? []} />

	{page.practice && <QuickPractice practice={page.practice} />}

	<AppCTA variant={page.appCtaVariant ?? 'phrase'} context={`hindi-bridge-${page.slug}`} />

	<RelatedContent links={related} />

	{(page.faq ?? []).length > 0 && (
		<>
			<h2>Common questions</h2>
			{page.faq!.map((f) => (
				<details>
					<summary>{f.question}</summary>
					<p>{f.answer}</p>
				</details>
			))}
		</>
	)}
</Learn>

<style>
	details {
		border: var(--border);
		border-radius: var(--radius);
		background: var(--card);
		padding: 0.9em 1.1em;
		margin-bottom: 0.6em;
	}
	details summary {
		font-weight: 600;
		cursor: pointer;
	}
	details p { margin: 0.6em 0 0.2em 0; }
</style>
