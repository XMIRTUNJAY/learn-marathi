---
import AppCTA from '../../components/AppCTA.astro';
import RelatedContent from '../../components/RelatedContent.astro';
import Learn from '../../layouts/Learn.astro';
import { getUnit, grammarTopics } from '../../lib/learn';
import { siteUrl } from '../../lib/site';

export async function getStaticPaths() {
	return grammarTopics.map((g) => ({ params: { topic: g.slug } }));
}

const { topic: slug } = Astro.params;
const topic = grammarTopics.find((g) => g.slug === slug);
if (!topic) throw new Error(`Unknown grammar topic: ${slug}`);

// Grammar notes for this topic: explicit verified picks (see learn.ts).
const notes = topic.picks.flatMap(({ unit: no, lessons }) => {
	const u = getUnit(no);
	return u.grammar.filter((g) => lessons.includes(g.lesson)).map((g) => ({ ...g, unit: no }));
});
---

<Learn
	title={`${topic.title} (with Examples)`}
	description={topic.description}
	kicker="Marathi Grammar"
	crumbs={[
		{ label: 'Grammar', href: siteUrl('/grammar/') },
		{ label: topic.title, href: siteUrl(`/grammar/${topic.slug}/`) },
	]}
	canonicalPath={`/grammar/${topic.slug}/`}
	about={topic.intent}
	meta={[`Units ${topic.unitRefs.join(', ')}`]}
>
	<h2>What you will learn</h2>
	<p>{topic.description} Notes below come straight from the Bol Marathi lessons.</p>

	{notes.map((g) => (
		<section>
			<h3>{g.titleEn} · <span lang="mr">{g.title}</span></h3>
			<p lang="mr">{g.text}</p>
			<p>{g.textEn}</p>
			{g.note && <p><em>Note:</em> {g.note}</p>}
			<p><small>From <a href={siteUrl(`/lessons/${g.unit}/`)}>Unit {g.unit}</a></small></p>
		</section>
	))}

	<AppCTA variant="grammar" context={`grammar-${topic.slug}`} />

	<RelatedContent links={topic.related} />
</Learn>
