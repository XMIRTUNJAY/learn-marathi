---
import AppCTA from '../../components/AppCTA.astro';
import RelatedContent from '../../components/RelatedContent.astro';
import Learn from '../../layouts/Learn.astro';
import { getUnit, grammarTopics } from '../../lib/learn';
import { siteUrl } from '../../lib/site';

export async function getStaticPaths() {
	return grammarTopics.map((g) => ({ params: { topic: g.slug } }));
}

const { topic: slug } = Astro.params;
const topic = grammarTopics.find((g) => g.slug === slug);
if (!topic) throw new Error(`Unknown grammar topic: ${slug}`);

// Grammar notes for this topic: matching rows from referenced units.
const notes = topic.unitRefs.flatMap((no) => {
	const u = getUnit(no);
	if (slug === 'pronouns') return u.grammar.filter((g) => /मी|तू|तो|प्रश्न|सर्वनाम|pronoun|question/i.test(`${g.title} ${g.titleEn} ${g.text} ${g.textEn}`)).map((g) => ({ ...g, unit: no }));
	if (slug === 'verbs') return u.grammar.filter((g) => /क्रिया|verb|tense|वाक्य|word order/i.test(`${g.title} ${g.titleEn} ${g.text} ${g.textEn}`)).map((g) => ({ ...g, unit: no }));
	return u.grammar.slice(0, 2).map((g) => ({ ...g, unit: no }));
});
const shown = notes.length > 0 ? notes : topic.unitRefs.flatMap((no) => getUnit(no).grammar.slice(0, 2).map((g) => ({ ...g, unit: no })));
---

<Learn
	title={`${topic.title} (with Examples)`}
	description={topic.description}
	kicker="Marathi Grammar"
	crumbs={[
		{ label: 'Grammar', href: siteUrl('/grammar/') },
		{ label: topic.title, href: siteUrl(`/grammar/${topic.slug}/`) },
	]}
	canonicalPath={`/grammar/${topic.slug}/`}
	about={topic.intent}
	meta={[`Units ${topic.unitRefs.join(', ')}`]}
>
	<h2>What you will learn</h2>
	<p>{topic.description} Notes below come straight from the Bol Marathi lessons.</p>

	<AppCTA variant="subtle" context={`grammar-${topic.slug}`} />

	{shown.map((g) => (
		<section>
			<h3>{g.titleEn} · <span lang="mr">{g.title}</span></h3>
			<p lang="mr">{g.text}</p>
			<p>{g.textEn}</p>
			{g.note && <p><em>Note:</em> {g.note}</p>}
			<p><small>From <a href={siteUrl(`/lessons/${g.unit}/`)}>Unit {g.unit}</a></small></p>
		</section>
	))}

	<AppCTA variant="grammar" context={`grammar-${topic.slug}`} />

	<RelatedContent links={topic.related} />

	<AppCTA variant="general" context={`grammar-${topic.slug}-end`} />
</Learn>
