---
import AppCTA from '../components/AppCTA.astro';
import Learn from '../layouts/Learn.astro';
import RelatedContent from '../components/RelatedContent.astro';
import ReviewNote from '../components/ReviewNote.astro';
import VocabTable from '../components/VocabTable.astro';
import { vocab } from '../lib/learn';
import { siteUrl } from '../lib/site';

// DRAFT (needsReview): the noun प्रेम is verified; the full "I love you"
// sentence pattern is NOT in the curriculum and is flagged, not invented.
const prem = vocab.find((w) => w.id === 'v-emo-05');
if (!prem) throw new Error('prem data missing');
---

<Learn
	title="How to Say I Love You in Marathi (Draft)"
	description="The Marathi word for love is प्रेम (prem) — with example and usage. Full sentence pattern pending native review."
	kicker="Marathi Phrases"
	crumbs={[
		{ label: 'Phrases', href: siteUrl('/phrases/') },
		{ label: 'How to say I love you (draft)', href: siteUrl('/how-to-say-i-love-you-in-marathi/') },
	]}
	canonicalPath="/how-to-say-i-love-you-in-marathi/"
	about="how to say i love you in marathi draft"
	meta={['Draft · needs native review']}
>
	<ReviewNote
		items={[
			'प्रेम (love, noun) and its example below are verified curriculum data.',
			'The complete "I love you" sentence pattern is not in the curriculum yet — do not rely on auto-translations; confirmation pending.',
		]}
	/>

	<h2>What is verified</h2>
	<VocabTable words={[prem]} caption="प्रेम" />
	<p>
		प्रेम names the feeling, as in आईचं प्रेम अनमोल (a mother's love is
		priceless). For the sentence you would actually say to a person, wait
		for the reviewed version — or ask in the app's phrase collections.
	</p>

	<AppCTA variant="phrase" context="say-love" />

	<RelatedContent
		links={[
			{ label: 'Daily conversation phrases', href: siteUrl('/phrases/daily/') },
			{ label: 'How to say hello', href: siteUrl('/how-to-say-hello-in-marathi/') },
			{ label: 'Emotions vocabulary', href: siteUrl('/lessons/17/') },
		]}
	/>
</Learn>
