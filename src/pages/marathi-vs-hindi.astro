---
import AppCTA from '../components/AppCTA.astro';
import Learn from '../layouts/Learn.astro';
import RelatedContent from '../components/RelatedContent.astro';
import ReviewNote from '../components/ReviewNote.astro';
import VocabTable from '../components/VocabTable.astro';
import { vocab } from '../lib/learn';
import { siteUrl } from '../lib/site';

// DRAFT (needsReview): काल/उद्या pair and हा/ही/हे neuter row are verified
// curriculum data; the आपण/आम्ही inclusive-exclusive paradigm is flagged,
// not stated as fact.
const kal = vocab.find((w) => w.id === 'v-time-03');
const udya = vocab.find((w) => w.id === 'v-time-02');
const ha = vocab.find((w) => w.marathi === 'हा');
const hi = vocab.find((w) => w.marathi === 'ही');
const he = vocab.find((w) => w.marathi === 'हे');
const aamhi = vocab.find((w) => w.id === 'v-pron-07');
if (!kal || !udya || !ha || !hi || !he || !aamhi) throw new Error('vs-hindi data missing');
---

<Learn
	title="Marathi vs Hindi: 3 Differences That Matter (Draft)"
	description="Three Marathi–Hindi differences from real curriculum data: काल vs उद्या, neuter हा/ही/हे, and the inclusive-exclusive 'we'. Draft pending review."
	kicker="Marathi Guide"
	crumbs={[
		{ label: 'Grammar', href: siteUrl('/grammar/') },
		{ label: 'Marathi vs Hindi (draft)', href: siteUrl('/marathi-vs-hindi/') },
	]}
	canonicalPath="/marathi-vs-hindi/"
	about="marathi vs hindi differences draft"
	meta={['Draft · needs native review']}
>
	<ReviewNote
		items={[
			'The आपण vs आम्ही (inclusive vs exclusive "we") distinction needs a native speaker to confirm forms and usage — it is flagged here, not taught as fact.',
			'Neuter-gender examples beyond हा/ही/हे need verification.',
		]}
	/>

	<h2>1. काल means only yesterday</h2>
	<p>
		Hindi कल covers both yesterday and tomorrow. Marathi splits them —
		and both halves are in the curriculum:
	</p>
	<VocabTable words={[kal, udya]} caption="काल vs उद्या" />

	<h2>2. Three genders, not two</h2>
	<p>
		Hindi has masculine and feminine. Marathi adds neuter — visible right
		in the demonstratives:
	</p>
	<VocabTable words={[ha, hi, he]} caption="हा ही हे" />

	<AppCTA variant="grammar" context="marathi-vs-hindi" />

	<h2>3. Two kinds of "we" (pending review)</h2>
	<p>
		Marathi distinguishes inclusive and exclusive "we" (आपण vs आम्ही).
		The curriculum verifies आम्ही:
	</p>
	<VocabTable words={[aamhi]} caption="आम्ही" />
	<p>
		The full inclusive/exclusive paradigm and usage rules are awaiting
		native-speaker confirmation — learn आम्ही confidently, treat the rest
		as preview.
	</p>

	<RelatedContent
		links={[
			{ label: 'Marathi pronouns', href: siteUrl('/grammar/pronouns/') },
			{ label: 'Sentence structure', href: siteUrl('/grammar/sentence-structure/') },
			{ label: 'Hindi to Marathi words', href: siteUrl('/hindi-to-marathi/words/') },
		]}
	/>

	<AppCTA variant="general" context="marathi-vs-hindi-end" />
</Learn>
