---
import Base from './Base.astro';
import Breadcrumbs, { type Crumb } from '../components/Breadcrumbs.astro';
import JsonLd from '../components/JsonLd.astro';
import { BRAND, REVIEWER } from '../data/brand';
import { siteUrl } from '../lib/site';

type Props = {
	title: string;
	description: string;
	kicker: string;
	crumbs: Crumb[];
	canonicalPath: string;
	about?: string;
	meta?: string[];
	alternates?: { lang: string; href: string }[];
	h1?: string;
	items?: { name: string; url: string }[];
};

const { title, description, kicker, crumbs, canonicalPath, about, meta = [], alternates, h1, items } = Astro.props;
// Absolute URLs must include the base (e.g. /learn-marathi) — Astro.url.pathname has it, Astro.site does not.
const pageUrl = new URL(Astro.url.pathname, Astro.site).toString();
const abs = (href: string) => new URL(href, Astro.site).toString();
const homeUrl = new URL(import.meta.env.BASE_URL, Astro.site).toString();
---

<Base title={title} description={description} alternates={alternates}>
	<JsonLd
		headline={title}
		description={description}
		url={pageUrl}
		type="LearningResource"
		about={about}
		items={items}
		breadcrumbs={[{ name: 'Learn Marathi', url: homeUrl }, ...crumbs.map((c) => ({ name: c.label, url: abs(c.href) }))]}
	/>
	<Breadcrumbs items={crumbs} />
	<div class="prose">
		<p class="kicker">{kicker}</p>
		<h1>{h1 ?? title}</h1>
		<p class="lede">{description}</p>
		{meta.length > 0 && (
			<p class="learn-meta">{meta.join(' · ')}</p>
		)}
		<p class="byline">
			Curated by <a href={BRAND.github} target="_blank" rel="noopener">xmirtunjay</a> for {BRAND.brandName} ·
			{REVIEWER.name ? `Reviewed by ${REVIEWER.name}${REVIEWER.role ? ` (${REVIEWER.role})` : ''}` : 'Reviewer: pending native-speaker review'} ·
			<a href={siteUrl('/how-it-works/')}>how the curriculum works</a>
		</p>
	</div>
	<div class="prose">
		<slot />
	</div>
</Base>

<style>
	.learn-meta {
		font-size: 0.8rem;
		color: rgb(var(--gray));
	}
	.byline {
		font-size: 0.82rem;
		color: rgb(var(--gray));
	}
</style>
