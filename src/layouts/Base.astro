---
import BaseHead from '../components/BaseHead.astro';
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';

type Props = {
	title: string;
	description: string;
	ogImage?: string;
	noindex?: boolean;
	alternates?: { lang: string; href: string }[];
	lang?: string;
};

const { title, description, ogImage, noindex, alternates, lang = 'en' } = Astro.props;
---

<!doctype html>
<html lang={lang}>
	<head>
		<BaseHead title={title} description={description} imageUrl={ogImage} noindex={noindex} alternates={alternates} />
	</head>
	<body>
		<SiteHeader />
		<main>
			<slot />
		</main>
		<SiteFooter />
	</body>
</html>
