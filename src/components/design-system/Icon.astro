---
// Icon — a small, consistent line-icon set for Bol Marathi.
// Replaces emoji used as icons (which read as amateur, not premium).
// Icons inherit `currentColor` and are decorative by default.
//
// Usage:  <Icon name="sprout" size={20} />
//         <Icon name="arrow-right" size={16} />   (often paired with a label)

interface Props {
  name: keyof typeof PATHS | string;
  size?: number;
  stroke?: number;
  class?: string;
  /** Provide a label to expose the icon to assistive tech; otherwise it is hidden. */
  label?: string;
}

const PATHS: Record<string, string> = {
  // Learning journey
  sprout: '<path d="M12 20v-7"/><path d="M12 13c0-3.3-2.7-6-6-6H4v1c0 3.3 2.7 6 6 6h2Z"/><path d="M12 11c0-2.8 2.2-5 5-5h2v1c0 2.8-2.2 5-5 5h-2Z"/>',
  book: '<path d="M4 5.5A2.5 2.5 0 0 1 6.5 3H19v15H6.5A2.5 2.5 0 0 0 4 20.5Z"/><path d="M4 20.5A2.5 2.5 0 0 1 6.5 18H19v3H6.5A2.5 2.5 0 0 1 4 20.5Z"/>',
  home: '<path d="M4 10.5 12 4l8 6.5"/><path d="M6 9.8V20h12V9.8"/><path d="M10 20v-5h4v5"/>',
  chat: '<path d="M20 12a7.5 7.5 0 0 1-10.9 6.7L4 20l1.3-5.1A7.5 7.5 0 1 1 20 12Z"/>',
  wrench: '<path d="M15.5 8.5a3.5 3.5 0 0 1-4.6 4.6L5 19l-1.5-1.5 5.9-5.9a3.5 3.5 0 0 1 4.6-4.6l-2 2 1.5 1.5 2-2Z"/>',
  speech: '<path d="M9 4h6a4 4 0 0 1 4 4v3a4 4 0 0 1-4 4h-3l-4 3v-3.5A4 4 0 0 1 5 11V8a4 4 0 0 1 4-4Z"/>',
  spark: '<path d="M12 3v4M12 17v4M3 12h4M17 12h4"/><path d="m6.3 6.3 2.4 2.4M15.3 15.3l2.4 2.4M17.7 6.3l-2.4 2.4M8.7 15.3l-2.4 2.4"/>',

  // Entry points / language
  globe: '<circle cx="12" cy="12" r="8"/><path d="M4 12h16"/><path d="M12 4a13 13 0 0 1 0 16 13 13 0 0 1 0-16Z"/>',
  link: '<path d="M10 13a4 4 0 0 0 5.7.3l2.3-2.3a4 4 0 0 0-5.7-5.7L11 6.7"/><path d="M14 11a4 4 0 0 0-5.7-.3L6 13a4 4 0 0 0 5.7 5.7L13 17.3"/>',
  compass: '<circle cx="12" cy="12" r="8"/><path d="m14.5 9.5-1.6 4.4-4.4 1.6 1.6-4.4Z"/>',

  // Method
  eye: '<path d="M2.5 12S6 6 12 6s9.5 6 9.5 6-3.5 6-9.5 6-9.5-6-9.5-6Z"/><circle cx="12" cy="12" r="2.5"/>',
  target: '<circle cx="12" cy="12" r="8"/><circle cx="12" cy="12" r="3.5"/><circle cx="12" cy="12" r="0.6" fill="currentColor"/>',
  refresh: '<path d="M20 11a8 8 0 0 0-14-5.2L4 8"/><path d="M4 4v4h4"/><path d="M4 13a8 8 0 0 0 14 5.2L20 16"/><path d="M20 20v-4h-4"/>',

  // UI
  'arrow-right': '<path d="M5 12h14"/><path d="m13 6 6 6-6 6"/>',
  'arrow-left': '<path d="M19 12H5"/><path d="m11 18-6-6 6-6"/>',
  check: '<path d="m5 12.5 4.5 4.5L19 7"/>',
  play: '<path d="M8 5.5v13l11-6.5Z"/>',
  question: '<circle cx="12" cy="12" r="8"/><path d="M9.7 9.5a2.3 2.3 0 0 1 4.5.6c0 1.5-2.2 2-2.2 3.4"/><circle cx="12" cy="16.6" r="0.6" fill="currentColor"/>',
  package: '<path d="M12 3 4 7v10l8 4 8-4V7Z"/><path d="m4 7 8 4 8-4"/><path d="M12 11v10"/>',
  phone: '<rect x="7" y="3" width="10" height="18" rx="2.5"/><path d="M11 18h2"/>',
  headphones: '<path d="M4 15v-3a8 8 0 0 1 16 0v3"/><rect x="3" y="14" width="4" height="6" rx="1.5"/><rect x="17" y="14" width="4" height="6" rx="1.5"/>',
  cards: '<rect x="4" y="5" width="11" height="14" rx="2"/><path d="M17 8h1.5A1.5 1.5 0 0 1 20 9.5v9A1.5 1.5 0 0 1 18.5 20H9"/>',
  mic: '<rect x="9" y="3" width="6" height="11" rx="3"/><path d="M6 11a6 6 0 0 0 12 0"/><path d="M12 17v3"/>',
  flame: '<path d="M12 3c2.5 3 4.5 5 4.5 8a4.5 4.5 0 0 1-9 0c0-1.2.4-2.2 1-3"/>',
  shield: '<path d="M12 3.5 5 6v6c0 4 3 7 7 8 4-1 7-4 7-8V6Z"/><path d="m9 12 2 2 4-4"/>',
  clipboard: '<rect x="6" y="4" width="12" height="16" rx="2"/><path d="M9 4h6v2.5H9Z"/><path d="M9 11h6M9 15h4"/>',
  trend: '<path d="M4 16.5 9.5 11l3.5 3.5L20 7.5"/><path d="M20 12V7.5h-4.5"/>',
  grid: '<rect x="4" y="4" width="7" height="7" rx="1.5"/><rect x="13" y="4" width="7" height="7" rx="1.5"/><rect x="4" y="13" width="7" height="7" rx="1.5"/><rect x="13" y="13" width="7" height="7" rx="1.5"/>',
};

const { name, size = 20, stroke = 1.6, class: className = '', label } = Astro.props;
const d = PATHS[name] ?? PATHS['spark'];
---

<svg
  class={`icon ${className}`}
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width={stroke}
  stroke-linecap="round"
  stroke-linejoin="round"
  role={label ? 'img' : 'presentation'}
  aria-label={label}
  aria-hidden={label ? undefined : 'true'}
  set:html={d}
/>

<style>
  .icon {
    display: inline-block;
    flex-shrink: 0;
    vertical-align: -0.15em;
  }
</style>
