---
/**
 * ProgressCard.astro
 *
 * Generates a shareable progress card as PNG using Canvas.
 * Can be downloaded, copied to clipboard, or shared via Web Share API.
 */

interface Props {
  variant?: 'review' | 'app' | 'general';
  class?: string;
}

const { variant = 'general', class: className = '' } = Astro.props;
---

<div class="progress-card-wrapper {className}" data-progress-card data-variant={variant}>
  <button
    type="button"
    class="share-card-btn"
    aria-label="Generate and share progress card"
    data-share-btn
  >
    <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
      <path d="M18 16.08c-.76 0-1.44.3-1.96.77L8.91 12.7c.05-.23.09-.46.09-.7s-.04-.47-.09-.7l7.05-4.11c.54.5 1.25.81 2.04.81 1.66 0 3-1.34 3-3s-1.34-3-3-3-3 1.34-3 3c0 .24.04.47.09.7L8.04 9.81C7.5 9.31 6.79 9 6 9c-1.66 0-3 1.34-3 3s1.34 3 3 3c.79 0 1.5-.31 2.04-.81l7.12 4.16c-.05.21-.08.43-.08.65 0 1.61 1.31 2.92 2.92 2.92s2.92-1.31 2.92-2.92-1.31-2.92-2.92-2.92z" fill="currentColor"/>
      <circle cx="18" cy="16.08" r="2.92" fill="none" stroke="currentColor" stroke-width="2"/>
    </svg>
    <span>Share Progress</span>
  </button>

  <div class="share-card-preview" hidden aria-hidden="true">
    <canvas id="progress-canvas" width="1200" height="630"></canvas>
    <div class="share-card-actions">
      <button type="button" class="btn" data-download-btn>Download PNG</button>
      <button type="button" class="btn ghost" data-copy-btn>Copy Image</button>
      <button type="button" class="btn ghost" data-share-api-btn>Share</button>
    </div>
  </div>
</div>

<style>
  .progress-card-wrapper {
    display: inline-flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .share-card-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.6rem 1rem;
    background: var(--accent);
    color: #fff;
    border: none;
    border-radius: var(--radius);
    font: inherit;
    font-weight: 600;
    font-size: 0.9rem;
    cursor: pointer;
    transition: all 0.15s ease;
    white-space: nowrap;
  }

  .share-card-btn:hover {
    filter: brightness(0.92);
    transform: translateY(-1px);
  }

  .share-card-btn:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  .share-card-preview {
    border: var(--border);
    border-radius: var(--radius);
    overflow: hidden;
    background: var(--card);
    box-shadow: 0 12px 32px rgb(45 27 21 / 0.14);
  }

  #progress-canvas {
    display: block;
    max-width: 100%;
    height: auto;
  }

  .share-card-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    padding: 1rem;
    border-top: var(--border);
    background: var(--container-low);
  }

  .share-card-actions .btn {
    min-height: 44px;
    line-height: 44px;
    padding: 0 1.25em;
    font-size: 0.88rem;
    margin: 0;
  }

  @media (max-width: 640px) {
    .share-card-actions { flex-direction: column; }
    .share-card-actions .btn { width: 100%; }
  }

  @media (prefers-reduced-motion: reduce) {
    .share-card-btn { transition: none; }
    .share-card-btn:hover { transform: none; }
  }
</style>

<script is:inline>
  (function () {
    const STORAGE_KEY = 'bol-marathi-progress';
    const STREAK_KEY = 'bol-marathi-streak-count';
    const WEAK_KEY = 'bol-marathi-weak-words';

    const wrapper = document.querySelector('[data-progress-card]');
    if (!wrapper) return;

    const btn = wrapper.querySelector('[data-share-btn]');
    const preview = wrapper.querySelector('.share-card-preview');
    const canvas = wrapper.querySelector('#progress-canvas');
    const downloadBtn = wrapper.querySelector('[data-download-btn]');
    const copyBtn = wrapper.querySelector('[data-copy-btn]');
    const shareApiBtn = wrapper.querySelector('[data-share-api-btn]');

    if (!btn || !preview || !canvas || !downloadBtn || !copyBtn || !shareApiBtn) return;

    const ctx = canvas.getContext('2d');
    if (!ctx) return;

    const CARD_W = 1200;
    const CARD_H = 630;

    function getProgressData() {
      try {
        const progress = JSON.parse(localStorage.getItem(STORAGE_KEY) || '{}');
        const streak = parseInt(localStorage.getItem(STREAK_KEY) || '0', 10);
        const weakWords = JSON.parse(localStorage.getItem(WEAK_KEY) || '[]');
        const completedUnits = Object.values(progress).filter((u) => u && u.completed).length;
        const totalWords = Object.keys(progress).filter(id => progress[id]?.completed).length + weakWords.length;

        return {
          streak,
          completedUnits,
          totalWords,
          weakCount: weakWords.length,
        };
      } catch {
        return { streak: 0, completedUnits: 0, totalWords: 0, weakCount: 0 };
      }
    }

    function drawCard(data) {
      // Clear
      ctx.clearRect(0, 0, CARD_W, CARD_H);

      // Background gradient
      const grad = ctx.createLinearGradient(0, 0, CARD_W, CARD_H);
      grad.addColorStop(0, '#FDFBF7');
      grad.addColorStop(0.5, '#FFF8F3');
      grad.addColorStop(1, '#F5EFE8');
      ctx.fillStyle = grad;
      ctx.fillRect(0, 0, CARD_W, CARD_H);

      // Accent line at top
      ctx.fillStyle = '#8E2D12';
      ctx.fillRect(0, 0, CARD_W, 6);

      // Decorative elements - subtle pattern
      ctx.fillStyle = '#8E2D12';
      ctx.globalAlpha = 0.03;
      for (let x = -100; x < CARD_W + 100; x += 80) {
        for (let y = -100; y < CARD_H + 100; y += 80) {
          ctx.beginPath();
          ctx.arc(x, y, 20, 0, Math.PI * 2);
          ctx.fill();
        }
      }
      ctx.globalAlpha = 1;

      // Title area
      ctx.fillStyle = '#2D1B15';
      ctx.font = '700 42px "Noto Sans Devanagari", "Mukta", system-ui, sans-serif';
      ctx.textAlign = 'left';
      ctx.fillText('My Marathi Progress', 80, 100);

      // Subtitle
      ctx.fillStyle = '#6D5B4E';
      ctx.font = '400 22px "Noto Sans Devanagari", "Mukta", system-ui, sans-serif';
      ctx.fillText('Learning with Bol Marathi', 80, 140);

      // Stats grid
      const stats = [
        { label: 'Day Streak', value: data.streak, icon: '🔥', color: '#8E2D12' },
        { label: 'Units Done', value: data.completedUnits, icon: '📚', color: '#C54F2C' },
        { label: 'Words Learned', value: data.totalWords.toLocaleString('en-IN'), icon: '📖', color: '#A43716' },
        { label: 'Needs Review', value: data.weakCount, icon: '🎯', color: '#2E7D5B' },
      ];

      const cardW = (CARD_W - 160 - 60) / 4;
      const cardH = 180;
      const startY = 200;

      stats.forEach((stat, i) => {
        const x = 80 + i * (cardW + 20);
        const y = startY;

        // Card background
        const cardGrad = ctx.createLinearGradient(x, y, x, y + cardH);
        cardGrad.addColorStop(0, '#FFFFFF');
        cardGrad.addColorStop(1, '#F7F3EF');
        ctx.fillStyle = cardGrad;
        ctx.strokeStyle = '#DFD0C7';
        ctx.lineWidth = 2;
        roundRect(ctx, x, y, cardW, cardH, 20, true, true);

        // Icon
        ctx.font = '50px "Apple Color Emoji", "Noto Color Emoji", sans-serif';
        ctx.textAlign = 'center';
        ctx.fillText(stat.icon, x + cardW / 2, y + 65);

        // Value
        ctx.fillStyle = stat.color;
        ctx.font = '700 48px "Noto Sans Devanagari", "Mukta", system-ui, sans-serif';
        ctx.fillText(String(stat.value), x + cardW / 2, y + 125);

        // Label
        ctx.fillStyle = '#6D5B4E';
        ctx.font = '500 18px "Noto Sans Devanagari", "Mukta", system-ui, sans-serif';
        ctx.fillText(stat.label, x + cardW / 2, y + 155);
      });

      // Bottom section - mascot area + branding
      const bottomY = startY + cardH + 40;

      // Decorative line
      ctx.strokeStyle = '#8E2D12';
      ctx.lineWidth = 2;
      ctx.setLineDash([10, 10]);
      ctx.beginPath();
      ctx.moveTo(80, bottomY);
      ctx.lineTo(CARD_W - 80, bottomY);
      ctx.stroke();
      ctx.setLineDash([]);

      // Brand text
      ctx.fillStyle = '#8E2D12';
      ctx.font = '700 28px "Noto Sans Devanagari", "Mukta", system-ui, sans-serif';
      ctx.textAlign = 'center';
      ctx.fillText('म  Learn Marathi', CARD_W / 2, bottomY + 50);

      ctx.fillStyle = '#6D5B4E';
      ctx.font = '400 18px "Noto Sans Devanagari", "Mukta", system-ui, sans-serif';
      ctx.fillText('bol-marathi.app · Learn from Hindi or English', CARD_W / 2, bottomY + 85);

      // URL
      ctx.fillStyle = '#6D5B4E';
      ctx.font = '400 16px "Noto Sans Devanagari", "Mukta", system-ui, sans-serif';
      ctx.fillText('xmirtunjay.github.io/learn-marathi/', CARD_W / 2, bottomY + 115);
    }

    function roundRect(ctx, x, y, w, h, r, fill, stroke) {
      if (w < 2 * r) r = w / 2;
      if (h < 2 * r) r = h / 2;
      ctx.beginPath();
      ctx.moveTo(x + r, y);
      ctx.arcTo(x + w, y, x + w, y + h, r);
      ctx.arcTo(x + w, y + h, x, y + h, r);
      ctx.arcTo(x, y + h, x, y, r);
      ctx.arcTo(x, y, x + w, y, r);
      ctx.closePath();
      if (fill) ctx.fill();
      if (stroke) ctx.stroke();
    }

    function generateCard() {
      const data = getProgressData();
      drawCard(data);
    }

    function trackCard(action, method) {
      try {
        document.dispatchEvent(new CustomEvent('progress-card', { detail: { action, method } }));
      } catch (e) { /* analytics listener optional */ }
    }

    function showPreview() {
      generateCard();
      trackCard('generate');
      preview.hidden = false;
      btn.textContent = 'Hide Card';
      btn.setAttribute('aria-expanded', 'true');
    }

    function hidePreview() {
      preview.hidden = true;
      btn.innerHTML = `
        <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
          <path d="M18 16.08c-.76 0-1.44.3-1.96.77L8.91 12.7c.05-.23.09-.46.09-.7s-.04-.47-.09-.7l7.05-4.11c.54.5 1.25.81 2.04.81 1.66 0 3-1.34 3-3s-1.34-3-3-3-3 1.34-3 3c0 .24.04.47.09.7L8.04 9.81C7.5 9.31 6.79 9 6 9c-1.66 0-3 1.34-3 3s1.34 3 3 3c.79 0 1.5-.31 2.04-.81l7.12 4.16c-.05.21-.08.43-.08.65 0 1.61 1.31 2.92 2.92 2.92s2.92-1.31 2.92-2.92-1.31-2.92-2.92-2.92z" fill="currentColor"/>
          <circle cx="18" cy="16.08" r="2.92" fill="none" stroke="currentColor" stroke-width="2"/>
        </svg>
        <span>Share Progress</span>
      `;
      btn.setAttribute('aria-expanded', 'false');
    }

    btn.addEventListener('click', () => {
      if (preview.hidden) {
        showPreview();
      } else {
        hidePreview();
      }
    });

    downloadBtn.addEventListener('click', () => {
      generateCard();
      trackCard('download');
      const link = document.createElement('a');
      link.download = `learn-marathi-progress-${Date.now()}.png`;
      link.href = canvas.toDataURL('image/png');
      link.click();
    });

    copyBtn.addEventListener('click', async () => {
      generateCard();
      try {
        canvas.toBlob(async (blob) => {
          if (!blob) return;
          try {
            await navigator.clipboard.write([new ClipboardItem({ 'image/png': blob })]);
            trackCard('share', 'copy');
            copyBtn.textContent = 'Copied!';
            setTimeout(() => copyBtn.textContent = 'Copy Image', 2000);
          } catch {
            // Fallback: copy data URL
            const dataUrl = canvas.toDataURL('image/png');
            await navigator.clipboard.writeText(dataUrl);
            copyBtn.textContent = 'Copied!';
            setTimeout(() => copyBtn.textContent = 'Copy Image', 2000);
          }
        }, 'image/png');
      } catch {
        copyBtn.textContent = 'Failed';
        setTimeout(() => copyBtn.textContent = 'Copy Image', 2000);
      }
    });

    shareApiBtn.addEventListener('click', async () => {
      generateCard();
      try {
        const blob = await new Promise(resolve => canvas.toBlob(resolve, 'image/png'));
        if (!blob) throw new Error('No blob');

        const file = new File([blob], `learn-marathi-progress-${Date.now()}.png`, { type: 'image/png' });

        if (navigator.canShare && navigator.canShare({ files: [file] })) {
          await navigator.share({
            title: 'My Marathi Learning Progress',
            text: `I'm learning Marathi with Bol Marathi! ${getProgressData().streak} day streak, ${getProgressData().completedUnits} units done.`,
            files: [file],
          });
          trackCard('share', 'native');
        } else {
          // Fallback to download
          downloadBtn.click();
        }
      } catch (err) {
        if (err.name !== 'AbortError') {
          shareApiBtn.textContent = 'Share failed';
          setTimeout(() => shareApiBtn.textContent = 'Share', 2000);
        }
      }
    });

    // Close preview on click outside
    document.addEventListener('click', (e) => {
      if (!wrapper.contains(e.target) && !preview.hidden) {
        hidePreview();
      }
    });
  })();
</script>