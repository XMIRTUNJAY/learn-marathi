---
/**
 * Search.astro
 *
 * Expected search-index.json format:
 *
 * [
 *   {
 *     "title": "Namaste",
 *     "type": "Word",
 *     "description": "A common Marathi greeting.",
 *     "keywords": "namaste namaskar नमस्ते नमस्कार greeting",
 *     "url": "/learn-marathi/lessons/greetings/"
 *   }
 * ]
 *
 * Designed for:
 * - Astro static sites
 * - GitHub Pages /learn-marathi/ deployment
 * - Marathi + Hindi + English search
 * - Keyboard + mouse + touch
 * - Astro View Transitions
 */

const searchIndexUrl = "/learn-marathi/search-index.json";
---

<div class="search-wrapper" data-search-root>
	<div class="search-box">
		<svg
			class="search-icon"
			viewBox="0 0 24 24"
			aria-hidden="true"
		>
			<path
				d="M21 21l-4.35-4.35m2.35-5.65a8 8 0 1 1-16 0 8 8 0 0 1 16 0z"
			/>
		</svg>

		<input
			type="search"
			id="search-input"
			class="search-input"
			placeholder="Search words, phrases, lessons..."
			autocomplete="off"
			autocorrect="off"
			autocapitalize="off"
			spellcheck="false"
			enterkeyhint="search"
			role="combobox"
			aria-label="Search Marathi lessons and words"
			aria-autocomplete="list"
			aria-controls="search-results"
			aria-expanded="false"
			aria-haspopup="listbox"
			data-search-input
		/>

		<button
			type="button"
			class="search-clear"
			aria-label="Clear search"
			data-search-clear
			hidden
		>
			<span aria-hidden="true">×</span>
		</button>

		<kbd class="search-shortcut" aria-hidden="true">/</kbd>
	</div>

	<div
		class="search-status"
		data-search-status
		role="status"
		aria-live="polite"
	></div>

	<ul
		id="search-results"
		class="search-results"
		role="listbox"
		aria-label="Search results"
		hidden
	></ul>
</div>

<style>
	.search-wrapper {
		position: relative;
		width: 100%;
		max-width: 460px;
	}

	.search-box {
		position: relative;
		display: flex;
		align-items: center;
		width: 100%;
	}

	.search-input {
		width: 100%;
		min-height: 44px;
		padding: 0.7rem 4.5rem 0.7rem 2.8rem;
		font: inherit;
		font-size: 0.95rem;
		border: var(--border);
		border-radius: var(--radius);
		background: var(--card);
		color: rgb(var(--gray-dark));
		transition:
			border-color 0.15s ease,
			box-shadow 0.15s ease,
			background 0.15s ease;
	}

	.search-input::placeholder {
		color: rgb(var(--gray) / 0.75);
	}

	.search-input:hover {
		border-color: rgb(var(--gray) / 0.45);
	}

	.search-input:focus {
		outline: none;
		border-color: var(--accent);
		box-shadow: 0 0 0 3px var(--accent-fixed);
	}

	.search-icon {
		position: absolute;
		left: 0.9rem;
		width: 1.1rem;
		height: 1.1rem;
		fill: none;
		stroke: var(--accent);
		stroke-width: 2;
		stroke-linecap: round;
		stroke-linejoin: round;
		pointer-events: none;
		z-index: 2;
	}

	.search-clear {
		position: absolute;
		right: 2.7rem;
		display: grid;
		place-items: center;
		width: 30px;
		height: 30px;
		padding: 0;
		border: 0;
		border-radius: 50%;
		background: transparent;
		color: rgb(var(--gray));
		cursor: pointer;
		font-size: 1.35rem;
		line-height: 1;
	}

	.search-clear:hover {
		background: var(--accent-fixed);
		color: var(--accent);
	}

	.search-shortcut {
		position: absolute;
		right: 0.75rem;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		min-width: 1.45rem;
		height: 1.45rem;
		padding: 0 0.3rem;
		border: 1px solid rgb(var(--gray) / 0.25);
		border-bottom-width: 2px;
		border-radius: 4px;
		background: rgb(var(--gray-light) / 0.35);
		color: rgb(var(--gray));
		font-size: 0.7rem;
		font-family: inherit;
	}

	.search-status {
		position: absolute;
		left: 0;
		right: 0;
		top: calc(100% + 0.25rem);
		z-index: 101;
		padding: 0 0.75rem;
		font-size: 0.75rem;
		color: rgb(var(--gray));
		pointer-events: none;
	}

	.search-results {
		position: absolute;
		top: calc(100% + 0.65rem);
		left: 0;
		right: 0;
		max-height: min(480px, 70vh);
		margin: 0;
		padding: 0.4rem;
		overflow-y: auto;
		list-style: none;
		background: var(--card);
		border: var(--border);
		border-radius: var(--radius);
		box-shadow: 0 12px 35px rgb(45 27 21 / 0.14);
		z-index: 100;
		overscroll-behavior: contain;
	}

	.search-results[hidden] {
		display: none;
	}

	.search-result-item {
		display: block;
		padding: 0.75rem 0.8rem;
		border-radius: calc(var(--radius) * 0.7);
		cursor: pointer;
		transition:
			background 0.1s ease,
			transform 0.1s ease;
	}

	.search-result-item + .search-result-item {
		margin-top: 2px;
	}

	.search-result-item:hover,
	.search-result-item.highlighted {
		background: var(--accent-fixed);
	}

	.search-result-item:active {
		transform: scale(0.99);
	}

	.search-result-title {
		font-weight: 650;
		line-height: 1.35;
		color: rgb(var(--black));
	}

	.search-result-title mark {
		background: transparent;
		color: var(--accent);
		font-weight: 750;
	}

	.search-result-meta {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		margin-top: 0.25rem;
	}

	.search-result-type {
		font-size: 0.68rem;
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.06em;
		color: var(--accent);
	}

	.search-result-desc {
		margin-top: 0.25rem;
		font-size: 0.82rem;
		line-height: 1.45;
		color: rgb(var(--gray));
	}

	.search-result-url {
		max-width: 100%;
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
		font-size: 0.7rem;
		color: rgb(var(--gray) / 0.7);
	}

	.search-empty,
	.search-loading,
	.search-error {
		padding: 1.1rem 0.9rem;
		text-align: center;
		font-size: 0.85rem;
		color: rgb(var(--gray));
	}

	.search-empty strong {
		color: rgb(var(--black));
	}

	.search-error {
		color: var(--accent);
	}

	@media (max-width: 640px) {
		.search-wrapper {
			max-width: none;
		}

		.search-input {
			min-height: 46px;
			font-size: 1rem;
		}

		.search-shortcut {
			display: none;
		}

		.search-clear {
			right: 0.65rem;
		}

		.search-results {
			max-height: 60vh;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.search-input,
		.search-result-item,
		.search-clear {
			transition: none;
		}
	}
</style>

<script type="module">
	import './SearchClient.ts';
</script>