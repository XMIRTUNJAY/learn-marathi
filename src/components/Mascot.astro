---
/**
 * Mascot.astro
 *
 * Reusable mascot component with different poses.
 * Poses: idle | wave | celebrate | read | think
 * Sizes: sm (48px) | md (80px) | lg (120px) | xl (160px)
 */

const POSES = ['idle', 'wave', 'celebrate', 'read', 'think'] as const;
const SIZES = ['sm', 'md', 'lg', 'xl'] as const;

type Pose = typeof POSES[number];
type Size = typeof SIZES[number];

interface Props {
  pose?: Pose;
  size?: Size;
  class?: string;
  ariaLabel?: string;
}

const { pose = 'idle', size = 'md', class: className = '', ariaLabel } = Astro.props;

if (!POSES.includes(pose)) {
  console.warn(`[Mascot] Unknown pose: ${pose}, falling back to 'idle'`);
}

const sizeMap = {
  sm: '48',
  md: '80',
  lg: '120',
  xl: '160',
};

const width = sizeMap[size];
const height = sizeMap[size];

const label = ariaLabel || `Learn Marathi mascot ${pose}`;
---

<div class="mascot-wrapper" data-mascot-pose={pose}>
  <img
    src={`/learn-marathi/mascot/${pose}.svg`}
    alt=""
    width={width}
    height={height}
    loading="lazy"
    decoding="async"
    aria-hidden="true"
    class="mascot-svg"
  />
  <span class="sr-only">{label}</span>
</div>

<style>
  .mascot-wrapper {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    line-height: 0;
  }

  .mascot-svg {
    width: 100%;
    height: auto;
    max-width: 100%;
    transition: transform 0.3s cubic-bezier(0.25, 0.8, 0.25, 1);
  }

  .mascot-wrapper:hover .mascot-svg {
    transform: scale(1.05);
  }

  /* Pose-specific animations via CSS (for non-SMIL environments) */
  .mascot-wrapper[data-mascot-pose="wave"] .mascot-svg {
    animation: mascot-wave 2s ease-in-out infinite;
  }

  .mascot-wrapper[data-mascot-pose="celebrate"] .mascot-svg {
    animation: mascot-bounce 0.8s cubic-bezier(0.25, 0.8, 0.25, 1) infinite;
  }

  .mascot-wrapper[data-mascot-pose="think"] .mascot-svg {
    animation: mascot-sway 4s ease-in-out infinite;
  }

  @keyframes mascot-wave {
    0%, 100% { transform: rotate(-5deg); }
    50% { transform: rotate(5deg); }
  }

  @keyframes mascot-bounce {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-8px); }
  }

  @keyframes mascot-sway {
    0%, 100% { transform: rotate(-1deg); }
    50% { transform: rotate(1deg); }
  }

  @media (prefers-reduced-motion: reduce) {
    .mascot-svg,
    .mascot-wrapper[data-mascot-pose="wave"] .mascot-svg,
    .mascot-wrapper[data-mascot-pose="celebrate"] .mascot-svg,
    .mascot-wrapper[data-mascot-pose="think"] .mascot-svg {
      animation: none;
      transform: none;
    }
    .mascot-wrapper:hover .mascot-svg {
      transform: none;
    }
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
</style>