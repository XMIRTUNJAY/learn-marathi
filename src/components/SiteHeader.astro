---
import Search from './Search.astro';
import Preferences from './Preferences.astro';
import { siteUrl } from '../lib/site';
import { HI_NAV } from '../i18n/hi';

const current = Astro.url.pathname.replace(import.meta.env.BASE_URL, '').replace(/\/$/, '');
const hi = Astro.url.pathname.includes('/hi/');
// Streak rendered client-side to avoid SSR localStorage access

// Grouped information architecture: Learn / Practice / Explore.
// Hindi pages keep the flat HI_NAV strip (smaller, localized link set).
const groups = [
	{
		label: 'Learn',
		match: 'learn',
		links: [
			{ href: siteUrl('/start/'), label: 'Start here', match: 'start' },
			{ href: siteUrl('/lessons/'), label: 'Course (26 units)', match: 'lessons' },
			{ href: siteUrl('/vocabulary/'), label: 'Vocabulary', match: 'vocabulary' },
			{ href: siteUrl('/phrases/'), label: 'Phrases', match: 'phrases' },
			{ href: siteUrl('/grammar/'), label: 'Grammar', match: 'grammar' },
			{ href: siteUrl('/marathi-pronunciation/'), label: 'Pronunciation', match: 'marathi-pronunciation' },
		],
	},
	{
		label: 'Practice',
		match: 'practice',
		links: [
			{ href: siteUrl('/quiz/'), label: 'Quizzes', match: 'quiz' },
			{ href: siteUrl('/review/'), label: 'Review (SRS)', match: 'review' },
			{ href: siteUrl('/downloads/'), label: 'Anki decks', match: 'downloads' },
		],
	},
	{
		label: 'Explore',
		match: 'explore',
		links: [
			{ href: siteUrl('/hindi-to-marathi/'), label: 'Hindi → Marathi', match: 'hindi-to-marathi' },
			{ href: siteUrl('/english-to-marathi/'), label: 'English → Marathi', match: 'english-to-marathi' },
			{ href: siteUrl('/hi/'), label: 'हिंदी में सीखें', match: 'hi' },
		],
	},
];

// Top-level items rendered outside the dropdowns (visible without a tap).
const directLinks = [
	{ href: siteUrl('/blog/'), label: 'Blog', match: 'blog' },
	{ href: siteUrl('/app/'), label: 'App', match: 'app' },
];

const links = hi
	? HI_NAV.map((l) => ({ href: siteUrl(l.href), label: l.label, match: l.href.replace(/\//g, '') }))
	: [];
---

<header class="site-header" transition:name="header" transition:persist>
	<div class="topbar" transition:name="nav" transition:persist>
		<div class="brand-group" transition:name="brand-group" transition:persist">
			<a class="brand" href={siteUrl('/')} aria-label="Learn Marathi home"><span class="brand-mr">म</span> Learn Marathi</a>
			<div id="streak-ring" aria-label="Streak"></div>
		</div>
		<div class="topbar-search">
			<Search />
		</div>
		<div class="topbar-actions">
			<Preferences />
			<div id="online-status" class="online-status" role="status" aria-live="polite" aria-atomic="true" title="Connection status"></div>
		</div>
	</div>
	<nav class={hi ? 'nav-strip' : 'nav-strip nav-strip--groups'} aria-label="Primary">
		{hi ? (
			links.map((link) => (
				<a
					href={link.href}
					aria-current={current === link.match || current.startsWith(link.match + '/') ? 'page' : undefined}
				>
					{link.label}
				</a>
			))
		) : (
			<>
			{groups.map((group) => {
				const active = group.links.some((l) => current === l.match || current.startsWith(l.match + '/'));
				return (
					<details class="nav-group">
						<summary aria-current={active ? 'page' : undefined}>{group.label}</summary>
						<div class="nav-menu">
							{group.links.map((link) => (
								<a
									href={link.href}
									aria-current={current === link.match || current.startsWith(link.match + '/') ? 'page' : undefined}
								>
									{link.label}
								</a>
							))}
						</div>
					</details>
				);
			})}
			{directLinks.map((link) => (
				<a
					href={link.href}
					aria-current={current === link.match || current.startsWith(link.match + '/') ? 'page' : undefined}
				>
					{link.label}
				</a>
			))}
			</>
		)}
	</nav>
</header>

<script>
	import { AnalyticsEvents } from '../lib/analytics';
	import { getPendingCount } from '../lib/sync';

	// Connectivity analytics (offline detected / back online + pending sync)
	function initConnectivityAnalytics() {
		if ((window as unknown as { __connAnalyticsInit?: boolean }).__connAnalyticsInit) return;
		(window as unknown as { __connAnalyticsInit?: boolean }).__connAnalyticsInit = true;
		window.addEventListener('offline', () => {
			try { AnalyticsEvents.offlineDetected(); } catch { /* ignore */ }
		});
		window.addEventListener('online', async () => {
			try {
				const pending = await getPendingCount().catch(() => 0);
				AnalyticsEvents.onlineRestored(pending);
			} catch { /* ignore */ }
		});
	}
	initConnectivityAnalytics();
	document.addEventListener('astro:page-load', initConnectivityAnalytics);

	// Nav dropdowns: close on outside click / Escape (progressive enhancement —
	// without JS the details elements still toggle on tap).
	function initNavGroups() {
		const groups = document.querySelectorAll('.nav-group');
		if (!groups.length) return;
		if ((window as unknown as { __navGroupsInit?: boolean }).__navGroupsInit) return;
		(window as unknown as { __navGroupsInit?: boolean }).__navGroupsInit = true;
		document.addEventListener('click', (e) => {
			groups.forEach((g) => {
				if (g.hasAttribute('open') && !g.contains(e.target as Node)) g.removeAttribute('open');
			});
		});
		document.addEventListener('keydown', (e) => {
			if (e.key === 'Escape') groups.forEach((g) => g.removeAttribute('open'));
		});
	}
	initNavGroups();
	document.addEventListener('astro:page-load', initNavGroups);

	// Render streak ring client-side
	(function () {
		const container = document.getElementById('streak-ring');
		if (!container) return;
		function getStreak() {
			try { return parseInt(localStorage.getItem('bol-marathi-streak-count') || '0', 10); } catch { return 0; }
		}
		function render() {
			const streak = getStreak();
			const size = 40, stroke = 3;
			const radius = size / 2 - stroke;
			const circumference = 2 * Math.PI * radius;
			const pct = Math.min(streak / 7, 1);
			const offset = circumference * (1 - pct);
			container.innerHTML = `
				<svg width="${size}" height="${size}" style="transform: rotate(-90deg)" aria-hidden="true">
					<circle class="bg" cx="${size/2}" cy="${size/2}" r="${radius}" fill="none" stroke="var(--container)" stroke-width="${stroke}" />
					<circle class="fg" cx="${size/2}" cy="${size/2}" r="${radius}" fill="none" stroke="var(--accent)" stroke-width="${stroke}" stroke-dasharray="${circumference}" stroke-dashoffset="${offset}" stroke-linecap="round" style="transition: stroke-dashoffset 0.5s ease" />
				</svg>
				<span class="streak-count">${streak}</span>
			`;
		}
		render();
		// Update on storage change (other tabs)
		window.addEventListener('storage', render);
	})();

	// Online/offline status indicator (dot-only; text for screen readers)
	(function () {
		const statusEl = document.getElementById('online-status');
		if (!statusEl) return;

		function updateStatus() {
			const online = navigator.onLine;
			statusEl.innerHTML = `<span class="status-dot ${online ? 'online' : 'offline'}" aria-hidden="true"></span><span class="sr-only">${online ? 'Online' : 'Offline'}</span>`;
			statusEl.classList.toggle('offline', !online);
			statusEl.setAttribute('title', online ? 'Online' : 'Offline — progress will sync when you reconnect');
		}

		window.addEventListener('online', updateStatus);
		window.addEventListener('offline', updateStatus);
		updateStatus();
	})();
</script>

<style>
	.site-header {
		border-bottom: var(--border);
		background: var(--paper);
		position: sticky;
		top: 0;
		z-index: 50;
	}
	.topbar {
		width: var(--measure-wide);
		max-width: calc(100% - 2em);
		margin: auto;
		padding: 0.5em 1em;
		display: flex;
		align-items: center;
		gap: 0.75em;
	}
	.brand {
		font-weight: 700;
		font-size: 1.2rem;
		color: rgb(var(--black));
		text-decoration: none;
		white-space: nowrap;
	}
	.brand-mr {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 1.6em;
		height: 1.6em;
		border-radius: 10px;
		background: var(--accent);
		color: #fff;
		font-size: 0.9em;
		margin-right: 0.4em;
		vertical-align: -0.3em;
	}
	.brand-group {
		display: flex;
		align-items: center;
		gap: 0.5em;
		flex-shrink: 0;
	}
	#streak-ring {
		display: flex;
		align-items: center;
		margin-left: 0.25em;
	}
	.streak-count {
		font-size: 0.7rem;
		font-weight: 700;
		color: var(--accent);
		line-height: 1;
	}
	.topbar-search {
		flex: 1 1 auto;
		min-width: 0;
		max-width: 24rem;
		margin-left: auto;
	}
	.topbar-actions {
		display: flex;
		align-items: center;
		gap: 0.5em;
		flex-shrink: 0;
	}
	.online-status {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 28px;
		height: 28px;
	}
	.status-dot {
		width: 10px;
		height: 10px;
		border-radius: 50%;
	}
	.status-dot.online { background: var(--success); box-shadow: 0 0 0 3px var(--success-bg); }
	.status-dot.offline { background: #dc2626; box-shadow: 0 0 0 3px #fee2e2; }
	.sr-only {
		position: absolute;
		width: 1px;
		height: 1px;
		padding: 0;
		margin: -1px;
		overflow: hidden;
		clip: rect(0, 0, 0, 0);
		white-space: nowrap;
		border: 0;
	}
	.nav-strip {
		width: var(--measure-wide);
		max-width: 100%;
		margin: auto;
		padding: 0 1em 0.5em 1em;
		display: flex;
		align-items: center;
		justify-content: safe center;
		gap: 0.15em;
		overflow-x: auto;
		scrollbar-width: thin;
		-webkit-overflow-scrolling: touch;
	}
	.nav-strip a {
		color: rgb(var(--gray-dark));
		text-decoration: none;
		font-size: 0.9rem;
		padding: 0.45em 0.75em;
		border-radius: 6px;
		white-space: nowrap;
		flex-shrink: 0;
	}
	.nav-strip a:hover {
		color: rgb(var(--black));
		background: rgb(var(--gray-light));
	}
	.nav-strip a[aria-current='page'] {
		color: rgb(var(--black));
		font-weight: 700;
		background: var(--accent-fixed);
	}
	/* Grouped nav (Learn / Practice / Explore) — zero-JS details dropdowns */
	.nav-strip--groups {
		overflow: visible; /* dropdown menus must not be clipped */
		justify-content: safe center;
	}
	.nav-group {
		position: relative;
		flex-shrink: 0;
	}
	.nav-group > summary {
		list-style: none;
		cursor: pointer;
		color: rgb(var(--gray-dark));
		font-size: 0.9rem;
		padding: 0.45em 0.75em;
		border-radius: 6px;
		white-space: nowrap;
		user-select: none;
	}
	.nav-group > summary::-webkit-details-marker { display: none; }
	.nav-group > summary::after {
		content: '▾';
		margin-left: 0.35em;
		font-size: 0.75em;
		color: rgb(var(--gray));
	}
	.nav-group[open] > summary::after { content: '▴'; }
	.nav-group > summary:hover {
		color: rgb(var(--black));
		background: rgb(var(--gray-light));
	}
	.nav-group > summary[aria-current='page'] {
		color: rgb(var(--black));
		font-weight: 700;
		background: var(--accent-fixed);
	}
	.nav-menu {
		position: absolute;
		top: calc(100% + 4px);
		left: 0;
		z-index: 60;
		display: grid;
		gap: 0.15em;
		min-width: 13em;
		padding: 0.45em;
		background: var(--paper);
		border: var(--border);
		border-radius: var(--radius);
		box-shadow: 0 10px 30px rgb(0 0 0 / 0.12);
	}
	.nav-menu a {
		padding: 0.55em 0.8em;
		border-radius: 8px;
	}
	@media (max-width: 560px) {
		.nav-menu {
			position: fixed;
			left: 1em;
			right: 1em;
			top: auto;
		}
	}
	@media (max-width: 860px) {
		.topbar { gap: 0.5em; padding: 0.5em 0.75em; }
		.brand { font-size: 1.05rem; }
		.topbar-actions .preferences-wrapper { display: none; }
		.topbar-search { max-width: none; }
		.nav-strip { padding: 0 0.75em 0.5em 0.75em; }
	}
</style>
