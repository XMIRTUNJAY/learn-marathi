---
import { BRAND } from '../data/brand';

type Props = {
	headline: string;
	description: string;
	datePublished?: string;
	dateModified?: string;
	url: string;
	type?: 'LearningResource' | 'Article' | 'FAQPage' | 'WebPage' | 'WebSite';
	about?: string;
	siteName?: string;
	faq?: { question: string; answer: string }[];
	breadcrumbs?: { name: string; url: string }[];
	items?: { name: string; url: string }[];
};

const { headline, description, datePublished, dateModified, url, type = 'LearningResource', about, siteName, faq = [], breadcrumbs = [], items = [] } = Astro.props;

const main: Record<string, unknown> =
	type === 'WebSite'
		? {
				'@context': 'https://schema.org',
				'@type': 'WebSite',
				name: siteName ?? headline,
				url,
				inLanguage: ['en', 'mr', 'hi'],
			}
		: {
				'@context': 'https://schema.org',
				'@type': type,
				headline: type === 'FAQPage' ? undefined : headline,
				name: type === 'FAQPage' ? headline : undefined,
				description,
				inLanguage: ['en', 'mr', 'hi'],
				...(datePublished ? { datePublished } : {}),
				...(dateModified ? { dateModified } : {}),
				author: { '@type': 'Organization', name: BRAND.brandName },
				...(about ? { about } : {}),
				mainEntityOfPage: { '@type': 'WebPage', '@id': url },
				...(type === 'FAQPage'
					? { mainEntity: faq.map((f) => ({ '@type': 'Question', name: f.question, acceptedAnswer: { '@type': 'Answer', text: f.answer } })) }
					: {}),
			};

const nodes: Record<string, unknown>[] = [main];

if (items.length > 0) {
	nodes.push({
		'@context': 'https://schema.org',
		'@type': 'ItemList',
		itemListElement: items.map((it, i) => ({
			'@type': 'ListItem',
			position: i + 1,
			name: it.name,
			url: it.url,
		})),
	});
}

if (breadcrumbs.length > 0) {
	nodes.push({
		'@context': 'https://schema.org',
		'@type': 'BreadcrumbList',
		itemListElement: breadcrumbs.map((c, i) => ({
			'@type': 'ListItem',
			position: i + 1,
			name: c.name,
			item: c.url,
		})),
	});
}
---

<script type="application/ld+json" set:html={JSON.stringify(nodes.length === 1 ? nodes[0] : nodes)} />
