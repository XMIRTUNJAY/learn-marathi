---
import { Word } from '../lib/learn';
import { simpleRespelling } from '../lib/simple';
import audioManifest from '../data/audio-manifest.json';
import SayScript from './SayScript.astro';
import { siteUrl } from '../lib/site';

interface Props {
	word: Word;
	roman?: 'diacritic' | 'simple' | 'none';
}
const { word, roman = 'diacritic' } = Astro.props;
const files = (audioManifest as { files?: Record<string, { word?: string }> }).files ?? {};
const audioSrc = files[word.id]?.word ? siteUrl(`/audio/${files[word.id].word}`) : null;
const showSimpleFirst = roman === 'simple';
---
<article class="vocab-card" tabindex="0" role="button" aria-label={`Flip to see meaning of ${word.marathi}`}>
	<div class="vocab-card-inner">
		<div class="vocab-card-front">
			<span class="vocab-mr" lang="mr">{word.marathi}</span>
			<span class="vocab-hint">Tap to reveal</span>
			{audioSrc && (
				<button class="say" data-audio={audioSrc} aria-label={`Listen: ${word.marathi}`}>🔊</button>
			)}
		</div>
		<div class="vocab-card-back">
			<span class="vocab-mr" lang="mr">{word.marathi}</span>
			{roman !== 'none' && (
				<span class="vocab-tr">
					<span class="r-a">{showSimpleFirst ? simpleRespelling(word.transliteration) : word.transliteration}</span>
					<span class="r-b" hidden>{showSimpleFirst ? word.transliteration : simpleRespelling(word.transliteration)}</span>
				</span>
			)}
			<span class="vocab-hi" lang="hi">{word.hindi}</span>
			<span class="vocab-en">{word.english}</span>
			<div class="vocab-ex">
				<span lang="mr">{word.exampleMarathi}</span>
				<small>{word.exampleEnglish}</small>
			</div>
			{audioSrc && (
				<button class="say" data-audio={audioSrc} aria-label={`Listen: ${word.marathi}`}>🔊</button>
			)}
		</div>
	</div>
</article>
<SayScript />

<style>
	.vocab-card {
		perspective: 1000px;
		width: 100%;
		aspect-ratio: 1 / 1;
		min-height: 140px;
		cursor: pointer;
	}
	.vocab-card-inner {
		position: relative;
		width: 100%;
		height: 100%;
		transition: transform 0.5s cubic-bezier(0.25, 0.8, 0.25, 1);
		transform-style: preserve-3d;
	}
	.vocab-card.flipped .vocab-card-inner {
		transform: rotateY(180deg);
	}
	.vocab-card-front,
	.vocab-card-back {
		position: absolute;
		inset: 0;
		backface-visibility: hidden;
		display: flex;
		flex-direction: column;
		justify-content: center;
		align-items: center;
		gap: 0.4em;
		padding: 1em;
		border: var(--border);
		border-radius: var(--radius);
		background: var(--card);
		text-align: center;
	}
	.vocab-card-back {
		transform: rotateY(180deg);
		flex-direction: column;
		align-items: center;
		gap: 0.35em;
	}
	.vocab-mr {
		font-size: 1.8rem;
		font-weight: 700;
		color: rgb(var(--black));
		line-height: 1.3;
	}
	.vocab-hint {
		font-size: 0.75rem;
		color: var(--accent);
		font-weight: 600;
		text-transform: uppercase;
		letter-spacing: 0.08em;
	}
	.vocab-tr {
		font-family: var(--font-mono);
		font-size: 0.8rem;
		color: rgb(var(--gray));
	}
	.vocab-hi {
		font-size: 1rem;
		color: rgb(var(--gray-dark));
		font-weight: 500;
	}
	.vocab-en {
		font-size: 1rem;
		color: rgb(var(--gray-dark));
		font-weight: 700;
	}
	.vocab-ex {
		font-size: 0.8rem;
		color: rgb(var(--gray));
		line-height: 1.5;
		display: flex;
		flex-direction: column;
		gap: 0.15em;
		margin-top: 0.25em;
	}
	.vocab-ex small { font-size: 0.7rem; color: rgb(var(--gray)); }
	.vocab-card .say {
		background: var(--accent-fixed);
		border: none;
		border-radius: var(--radius);
		padding: 0.35em 0.6em;
		cursor: pointer;
		font-size: 1rem;
		color: var(--accent-on-fixed);
		transition: all 0.15s ease;
	}
	.vocab-card .say:hover {
		background: var(--accent);
		color: #fff;
	}
	.vocab-card:focus-visible {
		outline: 2px solid var(--accent);
		outline-offset: 2px;
	}
	@media (prefers-reduced-motion: reduce) {
		.vocab-card-inner { transition: none; }
	}
</style>

<script>
	// Flip on click/Enter/Space
	document.querySelectorAll('.vocab-card').forEach(card => {
		card.addEventListener('click', () => card.classList.toggle('flipped'));
		card.addEventListener('keydown', (e) => {
			if (e.key === 'Enter' || e.key === ' ') {
				e.preventDefault();
				card.classList.toggle('flipped');
			}
		});
	});
</script>