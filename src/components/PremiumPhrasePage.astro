---
// PremiumPhrasePage — Premium phrase page template using new design system
// Replaces PhraseTopicPage with conversational PhraseCard components

import Learn from '../layouts/Learn.astro';
import PhraseCard from '../components/learning/PhraseCard.astro';
import QuickPractice from '../components/QuickPractice.astro';
import MistakeTable from '../components/MistakeTable.astro';
import AppCTA from '../components/AppCTA.astro';
import RelatedContent from '../components/RelatedContent.astro';
import PracticeCTA from '../components/learning/PracticeCTA.astro'
import RelatedLessons from '../components/layout/RelatedLessons.astro'
import SectionNav from '../components/layout/SectionNav.astro'
import { speakingFor, relatedFor, type SeoPage, FAMILY_BASE, FAMILY_LABEL } from '../lib/seo';
import { siteUrl } from '../lib/site';

type Props = { page: SeoPage };
const { page } = Astro.props;

const phrases = speakingFor(page);
const related = relatedFor(page);
const metaBits = [
  `${phrases.length} phrases`,
  ...(page.units?.length ? [page.units.length > 1 ? `Units ${page.units.join(', ')}` : `Unit ${page.units[0]}`] : []),
];

const navSections = [
  { id: 'objective-title', label: 'What you will learn' },
  { id: 'phrases-title', label: 'The phrases' },
  ...((page.mistakes ?? []).length ? [{ id: 'mistakes-title', label: 'Common mistakes' }] : []),
  ...(page.practice ? [{ id: 'practice-title', label: 'Practice' }] : []),
  ...((page.faq ?? []).length ? [{ id: 'faq-title', label: 'FAQ' }] : []),
];
---

<Learn
  title={page.title}
  h1={page.h1 ?? page.title}
  description={page.description}
  kicker={FAMILY_LABEL[page.family]}
  crumbs={[
    { label: FAMILY_LABEL[page.family], href: siteUrl(FAMILY_BASE[page.family]) },
    { label: page.title, href: siteUrl(`${FAMILY_BASE[page.family]}${page.slug}/`) },
  ]}
  canonicalPath={`${FAMILY_BASE[page.family]}${page.slug}/`}
  about={[page.primaryKeyword, ...page.secondaryKeywords].join('; ')}
  meta={metaBits}
  faq={page.faq ?? []}
>
  <!-- SECTION NAV — jump to section (sticky) -->
  <SectionNav sections={navSections} label="On this page" />

  <!-- LEARNING OBJECTIVE -->
  <section class="lesson-objective" aria-labelledby="objective-title">
    <h2 id="objective-title" class="kicker">What you will learn</h2>
    <div class="prose">
      {page.intro.map((para) => <p>{para}</p>)}
      {page.tip && <p class="tip"><strong>Tip:</strong> {page.tip}</p>}
    </div>
  </section>

  <!-- CORE LESSON: Conversational Phrases -->
  <section class="core-lesson" aria-labelledby="phrases-title">
    <header class="lesson-header">
      <h2 id="phrases-title">The Phrases</h2>
    </header>

    <div class="phrase-card-grid">
      {phrases.map((phrase) => (
        <PhraseCard phrase={phrase} />
      ))}
    </div>
  </section>

  <!-- ADDITIONAL SECTIONS -->
  {(page.sections ?? []).map((s) => (
    <section>
      <h2>{s.heading}</h2>
      {s.paragraphs.map((para) => <p>{para}</p>)}
    </section>
  ))}

  <!-- COMMON MISTAKES -->
  <div id="mistakes-title">
    <MistakeTable mistakes={page.mistakes ?? []} />
  </div>

  <!-- QUICK PRACTICE -->
  {page.practice && (
    <div id="practice-title">
      <QuickPractice practice={page.practice} />
    </div>
  )}

  <!-- PRACTICE CTA - Contextual app bridge -->
  <PracticeCTA variant="phrase" context={`phrases-${page.slug}`} />

  <!-- RELATED LESSONS -->
  <RelatedLessons links={related} max={4} title="Continue learning" />

  <!-- FAQ -->
  {(page.faq ?? []).length > 0 && (
    <>
      <h2 id="faq-title">Common questions</h2>
      {page.faq!.map((f) => (
        <details>
          <summary>{f.question}</summary>
          <p>{f.answer}</p>
        </details>
      ))}
    </>
  )}
</Learn>

<style>
  /* Anchor clearance for the sticky section nav */
  #objective-title,
  #phrases-title,
  #mistakes-title,
  #practice-title,
  #faq-title { scroll-margin-top: 5.5rem; }

  .lesson-objective {
    margin: var(--space-6) 0;
    padding: var(--space-5);
    background: var(--color-container-low);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
  }

  .lesson-objective .kicker { margin-bottom: var(--space-2); }

  .core-lesson { margin: var(--space-6) 0; }

  .lesson-header {
    margin-bottom: var(--space-4);
  }

  .lesson-header h2 { margin: 0; font-size: var(--text-h2); }

  .phrase-card-grid {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  details {
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    background: var(--color-surface);
    padding: var(--space-3) var(--space-4);
    margin-bottom: var(--space-3);
  }

  details summary {
    font-weight: 600;
    cursor: pointer;
  }

  details p { margin: var(--space-2) 0 0 0; }
</style>