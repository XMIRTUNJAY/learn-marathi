---
import type { Word } from '../lib/learn';
import { simpleRespelling } from '../lib/simple';

type Props = {
	words: Word[];
	caption?: string;
	// Pronunciation column: 'diacritic' (precise, default) | 'simple'
	// (plain respelling) | 'none' (hidden — Hindi path reads Devanagari).
	// toggle=true adds a CSS-only checkbox switching simple ↔ precise.
	roman?: 'diacritic' | 'simple' | 'none';
	toggle?: boolean;
	context?: string;
};
const { words, caption, roman = 'diacritic', toggle = roman !== 'none', context = 'vocab' } = Astro.props;
const showSimpleFirst = roman === 'simple';
---

<div class="table-scroll" role="region" aria-label={caption ?? 'Vocabulary'} tabindex="0">
	{toggle && (
		<label class="roman-toggle">
			<input type="checkbox" class={`roman-check-${context}`} />
			Show precise pronunciation
		</label>
	)}
	<table class="vocab">
		<thead>
			<tr>
				<th scope="col">Marathi</th>
				{roman !== 'none' && <th scope="col">Pronunciation</th>}
				<th scope="col">Hindi</th>
				<th scope="col">English</th>
				<th scope="col">Example</th>
			</tr>
		</thead>
		<tbody>
			{words.map((w) => (
				<tr>
					<td class="mr" lang="mr">
						{w.marathi}
						<button type="button" class="say" data-say={w.marathi} aria-label={`Listen: ${w.marathi}`}>🔊</button>
					</td>
					{roman !== 'none' && (
						<td class="tr">
							<span class="r-a">{showSimpleFirst ? simpleRespelling(w.transliteration) : w.transliteration}</span>
							{toggle && (
								<span class="r-b">{showSimpleFirst ? w.transliteration : simpleRespelling(w.transliteration)}</span>
							)}
						</td>
					)}
					<td lang="hi">{w.hindi}</td>
					<td>{w.english}</td>
					<td>
						<span lang="mr">{w.exampleMarathi}</span>
						<br />
						<small>{w.exampleEnglish}</small>
					</td>
				</tr>
			))}
		</tbody>
	</table>
</div>

<script is:inline>
	(function () {
		// Device text-to-speech for Marathi headwords. No network, no keys —
		// uses the visitor's own voices. Prefers a Marathi voice, falls back
		// to Hindi (same script, closest phonetics), then system default.
		// Buttons remove themselves if speech synthesis is unavailable.
		if (window.__sayInit) return;
		window.__sayInit = true;
		if (!('speechSynthesis' in window)) {
			document.querySelectorAll('.say').forEach((b) => b.remove());
			return;
		}
		var voice = null;
		function pickVoice() {
			try {
				var voices = window.speechSynthesis.getVoices() || [];
				voice =
					voices.find(function (v) { return (v.lang || '').toLowerCase().indexOf('mr') === 0; }) ||
					voices.find(function (v) { return (v.lang || '').toLowerCase().indexOf('hi') === 0; }) ||
					null;
			} catch (err) { voice = null; }
		}
		pickVoice();
		if ('onvoiceschanged' in window.speechSynthesis) {
			window.speechSynthesis.onvoiceschanged = pickVoice;
		}
		document.addEventListener('click', (e) => {
			var btn = e.target.closest ? e.target.closest('[data-say]') : null;
			if (!btn) return;
			try {
				window.speechSynthesis.cancel();
				var u = new SpeechSynthesisUtterance(btn.getAttribute('data-say') || '');
				u.lang = 'mr-IN';
				u.rate = 0.85;
				if (voice) u.voice = voice;
				window.speechSynthesis.speak(u);
			} catch (err) {
				/* voice missing — table content still fully usable */
			}
		});
		if (document.hidden !== undefined) {
			document.addEventListener('visibilitychange', () => {
				if (document.hidden) { try { window.speechSynthesis.cancel(); } catch (err) {} }
			});
		}
	})();
</script>

<style>
	.roman-toggle {
		display: inline-flex;
		align-items: center;
		gap: 0.4em;
		font-size: 0.82rem;
		color: rgb(var(--gray));
		margin-bottom: 0.6em;
		cursor: pointer;
	}
	.roman-toggle input {
		width: 1em;
		height: 1em;
		accent-color: var(--accent);
	}
	.r-b { display: none; }
	.roman-toggle:has(input:checked) ~ table .r-a { display: none; }
	.roman-toggle:has(input:checked) ~ table .r-b { display: inline; }
	.say {
		background: transparent;
		border: none;
		cursor: pointer;
		font-size: 0.9em;
		padding: 0.1em 0.2em;
		margin-left: 0.25em;
		line-height: 1;
	}
	.say:hover {
		filter: brightness(0.85);
	}
</style>
