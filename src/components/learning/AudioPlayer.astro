---
// AudioPlayer — Premium audio component with full playback controls
// Replaces SayScript + inline .say buttons
import { siteUrl } from '../lib/site';

interface Props {
  src: string;                    // Audio file URL (pre-generated or TTS fallback)
  text: string;                   // Marathi text being spoken
  transliteration?: string;       // Optional transliteration
  translation?: string;           // Optional English translation
  size?: 'sm' | 'md' | 'lg';      // Visual size variant
  showText?: boolean;             // Show text alongside player
  autoplay?: boolean;
  loop?: boolean;
  class?: string;                 // Additional CSS classes
}

const {
  src,
  text,
  transliteration,
  translation,
  size = 'md',
  showText = true,
  autoplay = false,
  loop = false,
  class: className = '',
} = Astro.props;

const playerId = `audio-${Math.random().toString(36).slice(2, 9)}`;
---

<div class="audio-player audio-player--{size} {className}" data-audio-player>
  <audio
    id={playerId}
    src={src}
    preload="metadata"
    {autoplay && 'autoplay'}
    {loop && 'loop'}
  ></audio>

  <div class="audio-player__controls" role="group" aria-label={`Play ${text}`}>
    <button
      type="button"
      class="audio-player__btn audio-player__btn--play"
      aria-label={`Play ${text}`}
      data-action="play"
    >
      <svg class="audio-player__icon" viewBox="0 0 24 24" aria-hidden="true" width="20" height="20">
        <path fill="currentColor" d="M8 5v14l11-7z"/>
      </svg>
      <svg class="audio-player__icon audio-player__icon--pause" viewBox="0 0 24 24" aria-hidden="true" width="20" height="20">
        <path fill="currentColor" d="M6 19h4V5H6v14zm8-14v14h4V5h-4z"/>
      </svg>
    </button>

    <div class="audio-player__progress" role="slider" aria-label="Playback progress" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0" tabindex="0">
      <div class="audio-player__progress-bar" data-progress-bar></div>
      <div class="audio-player__progress-fill" data-progress-fill></div>
    </div>

    <span class="audio-player__time" data-time-current>0:00</span>
    <span class="audio-player__time-separator" aria-hidden="true">/</span>
    <span class="audio-player__time" data-time-total>0:00</span>

    <button
      type="button"
      class="audio-player__btn audio-player__btn--speed"
      aria-label="Playback speed: 1x"
      data-action="speed"
    >
      <span class="audio-player__speed-text" data-speed-text>1×</span>
    </button>
  </div>

  {showText && (
    <div class="audio-player__content">
      <span class="audio-player__marathi" lang="mr">{text}</span>
      {transliteration && <span class="audio-player__transliteration">{transliteration}</span>}
      {translation && <span class="audio-player__translation">{translation}</span>}
    </div>
  )}
</div>

<style>
  .audio-player {
    display: inline-flex;
    flex-direction: column;
    gap: var(--space-2);
    font-family: var(--font-body);
  }

  .audio-player--sm { --player-height: 36px; --icon-size: 16px; }
  .audio-player--md { --player-height: 44px; --icon-size: 20px; }
  .audio-player--lg { --player-height: 56px; --icon-size: 24px; }

  .audio-player__controls {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    height: var(--player-height);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-full);
    padding: 0 var(--space-3);
  }

  .audio-player__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: var(--player-height);
    height: var(--player-height);
    background: transparent;
    border: none;
    border-radius: var(--radius-full);
    color: var(--color-text);
    cursor: pointer;
    transition: background var(--duration-fast) var(--ease-out), color var(--duration-fast) var(--ease-out);
  }

  .audio-player__btn:hover {
    background: var(--color-container);
    color: var(--color-primary);
  }

  .audio-player__btn:focus-visible {
    outline: 2px solid var(--color-primary);
    outline-offset: 2px;
  }

  .audio-player__btn--play {
    background: var(--color-primary);
    color: var(--color-text-on-primary);
    flex-shrink: 0;
  }

  .audio-player__btn--play:hover {
    background: var(--color-primary-dark);
    color: var(--color-text-on-primary);
  }

  .audio-player__icon {
    width: var(--icon-size);
    height: var(--icon-size);
    flex-shrink: 0;
  }

  .audio-player__icon--pause { display: none; }

  .audio-player[data-playing="true"] .audio-player__icon { display: none; }
  .audio-player[data-playing="true"] .audio-player__icon--pause { display: block; }

  .audio-player__progress {
    position: relative;
    flex: 1;
    height: 4px;
    background: var(--color-container);
    border-radius: 2px;
    cursor: pointer;
    min-width: 60px;
  }

  .audio-player__progress:focus-visible {
    outline: 2px solid var(--color-primary);
    outline-offset: 2px;
    border-radius: 2px;
  }

  .audio-player__progress-fill {
    position: absolute;
    top: 0;
    left: 0;
    height: 100%;
    width: 0%;
    background: var(--color-primary);
    border-radius: 2px;
    transition: width 0.1s linear;
  }

  .audio-player__time {
    font-size: var(--text-caption);
    font-family: var(--font-mono);
    color: var(--color-text-muted);
    min-width: 2.5em;
    text-align: right;
  }

  .audio-player__time:last-of-type { text-align: left; }

  .audio-player__time-separator {
    font-size: var(--text-caption);
    color: var(--color-text-muted);
  }

  .audio-player__btn--speed {
    font-size: var(--text-caption);
    font-weight: 600;
    color: var(--color-text-muted);
    width: auto;
    padding: 0 var(--space-2);
  }

  .audio-player__btn--speed:hover {
    color: var(--color-primary);
    background: var(--color-primary-fixed);
  }

  .audio-player__content {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    padding-inline: var(--space-1);
  }

  .audio-player__marathi {
    font-family: var(--font-display);
    font-size: var(--text-marathi-word);
    font-weight: 700;
    color: var(--color-text);
    line-height: 1.3;
  }

  .audio-player__transliteration {
    font-family: var(--font-mono);
    font-size: var(--text-transliteration);
    color: var(--color-text-muted);
  }

  .audio-player__translation {
    font-size: var(--text-body-sm);
    color: var(--color-text-muted);
  }

  /* Size variants for text */
  .audio-player--sm .audio-player__marathi { font-size: 1.25rem; }
  .audio-player--sm .audio-player__transliteration { font-size: 0.75rem; }
  .audio-player--sm .audio-player__translation { font-size: 0.75rem; }

  .audio-player--lg .audio-player__marathi { font-size: 2.25rem; }
  .audio-player--lg .audio-player__transliteration { font-size: 1rem; }
  .audio-player--lg .audio-player__translation { font-size: var(--text-body); }

  /* Loading state */
  .audio-player[data-loading="true"] .audio-player__btn--play {
    opacity: 0.6;
    cursor: wait;
  }

  /* Error state */
  .audio-player[data-error="true"] .audio-player__btn--play {
    background: var(--color-error);
    color: white;
  }

  .audio-player[data-error="true"] .audio-player__icon--pause { display: none; }
</style>

<script>
  // AudioPlayer client-side logic
  function initAudioPlayers() {
    document.querySelectorAll('[data-audio-player]:not([data-player-init])').forEach(player => {
      player.setAttribute('data-player-init', 'true');

      const audio = player.querySelector('audio');
      const playBtn = player.querySelector('[data-action="play"]');
      const progressBar = player.querySelector('[data-progress-bar]');
      const progressFill = player.querySelector('[data-progress-fill]');
      const timeCurrent = player.querySelector('[data-time-current]');
      const timeTotal = player.querySelector('[data-time-total]');
      const speedBtn = player.querySelector('[data-action="speed"]');
      const speedText = player.querySelector('[data-speed-text]');

      if (!audio || !playBtn) return;

      const speeds = [0.75, 1, 1.25, 1.5];
      let speedIndex = 1; // 1x

      function formatTime(seconds: number): string {
        if (isNaN(seconds)) return '0:00';
        const mins = Math.floor(seconds / 60);
        const secs = Math.floor(seconds % 60);
        return `${mins}:${secs.toString().padStart(2, '0')}`;
      }

      function updateProgress() {
        if (!audio.duration) return;
        const pct = (audio.currentTime / audio.duration) * 100;
        progressFill.style.width = `${pct}%`;
        progressBar.setAttribute('aria-valuenow', Math.round(pct));
        timeCurrent.textContent = formatTime(audio.currentTime);
      }

      function updateTotalTime() {
        timeTotal.textContent = formatTime(audio.duration);
      }

      function togglePlay() {
        if (audio.paused) {
          audio.play().catch(() => {
            player.setAttribute('data-error', 'true');
          });
        } else {
          audio.pause();
        }
      }

      function handleProgressClick(e: MouseEvent) {
        const rect = progressBar.getBoundingClientRect();
        const pct = (e.clientX - rect.left) / rect.width;
        audio.currentTime = pct * audio.duration;
      }

      function handleSpeedClick() {
        speedIndex = (speedIndex + 1) % speeds.length;
        audio.playbackRate = speeds[speedIndex];
        speedText.textContent = `${speeds[speedIndex]}×`;
        speedBtn.setAttribute('aria-label', `Playback speed: ${speeds[speedIndex]}x`);
      }

      function handleKeyDown(e: KeyboardEvent) {
        if (e.target !== progressBar) return;
        if (e.key === 'ArrowLeft') {
          audio.currentTime = Math.max(0, audio.currentTime - 5);
        } else if (e.key === 'ArrowRight') {
          audio.currentTime = Math.min(audio.duration, audio.currentTime + 5);
        } else if (e.key === 'Home') {
          audio.currentTime = 0;
        } else if (e.key === 'End') {
          audio.currentTime = audio.duration;
        }
      }

      // Event listeners
      playBtn.addEventListener('click', togglePlay);
      progressBar.addEventListener('click', handleProgressClick);
      progressBar.addEventListener('keydown', handleKeyDown);
      speedBtn.addEventListener('click', handleSpeedClick);

      audio.addEventListener('play', () => player.setAttribute('data-playing', 'true'));
      audio.addEventListener('pause', () => player.removeAttribute('data-playing'));
      audio.addEventListener('timeupdate', updateProgress);
      audio.addEventListener('loadedmetadata', updateTotalTime);
      audio.addEventListener('ended', () => {
        player.removeAttribute('data-playing');
        if (audio.loop) audio.play();
      });
      audio.addEventListener('waiting', () => player.setAttribute('data-loading', 'true'));
      audio.addEventListener('canplay', () => player.removeAttribute('data-loading'));
      audio.addEventListener('error', () => player.setAttribute('data-error', 'true'));

      // Keyboard: Space/Enter on player toggles play
      player.addEventListener('keydown', (e: KeyboardEvent) => {
        if ((e.key === ' ' || e.key === 'Enter') && e.target === player) {
          e.preventDefault();
          togglePlay();
        }
      });
    });
  }

  initAudioPlayers();
  document.addEventListener('astro:page-load', initAudioPlayers);
</script>