---
// EntryPoints — the three ways into Bol Marathi: English, Hindi, or continuing.
// Used as the single "where are you starting from?" section on the homepage.
// Heading is prop-driven so it never duplicates another section's kicker.

import Icon from '../design-system/Icon.astro';
import SectionHead from './SectionHead.astro';
import { siteUrl } from '../../lib/site';

interface Props {
  kicker?: string;
  title?: string;
  lede?: string;
  class?: string;
}

const {
  kicker = 'Start here',
  title = 'Where are you starting from?',
  lede = 'Pick the language you already think in. Bol Marathi meets you there and takes you to spoken Marathi.',
  class: className = '',
} = Astro.props;

const entries = [
  {
    id: 'english',
    label: 'I speak English',
    sublabel: 'English → Marathi',
    desc: 'Everyday words and sentences with English meanings, pronunciation and examples.',
    href: siteUrl('/english-to-marathi/'),
    icon: 'globe',
    tone: 'primary',
  },
  {
    id: 'hindi',
    label: 'I speak Hindi',
    sublabel: 'हिंदी → मराठी',
    desc: 'Word pairs and sentence bridges mapped from the Hindi you already know.',
    href: siteUrl('/hindi-to-marathi/'),
    icon: 'link',
    tone: 'success',
  },
  {
    id: 'continue',
    label: 'I know some Marathi',
    sublabel: 'Continue learning',
    desc: 'Practice and advance with quizzes, spaced repetition and the 26-unit course.',
    href: siteUrl('/start/'),
    icon: 'compass',
    tone: 'warning',
  },
] as const;
---

<section class={`entry-points ${className}`} aria-labelledby="entry-points-title">
  <SectionHead kicker={kicker} title={title} lede={lede} id="entry-points-title" />

  <ul class="entry-points__grid">
    {entries.map((entry, i) => (
      <li class={`entry-points__card entry-points__card--${entry.tone} reveal reveal-delay-${i + 1}`}>
        <a class="entry-points__link" href={entry.href} data-funnel="entry_point_click" data-entry={entry.id}>
          <span class="entry-points__icon" aria-hidden="true"><Icon name={entry.icon} size={24} /></span>
          <div class="entry-points__content">
            <span class="entry-points__sublabel">{entry.sublabel}</span>
            <h3 class="entry-points__label">{entry.label}</h3>
            <p class="entry-points__desc">{entry.desc}</p>
          </div>
          <span class="entry-points__arrow" aria-hidden="true"><Icon name="arrow-right" size={20} /></span>
        </a>
      </li>
    ))}
  </ul>
</section>

<style>
  .entry-points__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: var(--space-4);
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .entry-points__card {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-sm);
    transition: transform var(--duration-base) var(--ease-out),
                box-shadow var(--duration-base) var(--ease-out),
                border-color var(--duration-fast) var(--ease-out);
  }

  .entry-points__card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-lg);
    border-color: var(--color-primary);
  }

  .entry-points__link {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    height: 100%;
    padding: var(--space-5);
    text-decoration: none;
    color: inherit;
  }

  .entry-points__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 48px;
    border-radius: var(--radius);
    background: var(--color-primary-fixed);
    color: var(--color-primary);
  }

  .entry-points__card--success .entry-points__icon {
    background: var(--color-success-bg);
    color: var(--color-success);
  }

  .entry-points__card--warning .entry-points__icon {
    background: var(--color-warning-bg);
    color: var(--color-warning);
  }

  .entry-points__content {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .entry-points__sublabel {
    font-size: var(--text-caption);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-text-muted);
  }

  .entry-points__label {
    margin: 0;
    font-size: var(--text-h4);
    font-weight: 700;
    color: var(--color-text);
    line-height: 1.25;
  }

  .entry-points__desc {
    margin: 0;
    font-size: var(--text-body-sm);
    color: var(--color-text-muted);
    line-height: 1.6;
  }

  .entry-points__arrow {
    display: inline-flex;
    align-items: center;
    color: var(--color-text-muted);
    transition: transform var(--duration-fast) var(--ease-out), color var(--duration-fast) var(--ease-out);
  }

  .entry-points__link:hover .entry-points__arrow {
    transform: translateX(4px);
    color: var(--color-primary);
  }
</style>
