---
// LearningPath — Visual learning journey component
// Shows the path from START to SPEAK

import Icon from '../design-system/Icon.astro';

interface Props {
  currentStep?: number;  // 0-5, highlights current position
  class?: string;
}

const { currentStep = 0, class: className = '' } = Astro.props;

const steps = [
  { id: 'start', label: 'Start', icon: 'sprout', desc: 'First words', href: '/start/' },
  { id: 'essential', label: 'Essential', icon: 'book', desc: 'Core vocabulary', href: '/vocabulary/' },
  { id: 'everyday', label: 'Everyday', icon: 'home', desc: 'Daily words', href: '/vocabulary/daily/' },
  { id: 'phrases', label: 'Phrases', icon: 'chat', desc: 'Useful sentences', href: '/phrases/' },
  { id: 'sentences', label: 'Sentences', icon: 'wrench', desc: 'Build your own', href: '/grammar/' },
  { id: 'conversations', label: 'Conversations', icon: 'speech', desc: 'Real dialogue', href: '/phrases/conversations/' },
  { id: 'speak', label: 'Speak', icon: 'spark', desc: 'Fluent Marathi', href: '/app/' },
] as const;
---

<nav class={`learning-path ${className}`} aria-label="Learning journey">
  <ol class="learning-path__steps">
    {steps.map((step, i) => {
      const isActive = i === currentStep;
      const isCompleted = i < currentStep;
      return (
        <li class={`learning-path__step ${isActive ? 'learning-path__step--active' : ''} ${isCompleted ? 'learning-path__step--completed' : ''}`} data-step={step.id}>
          <a href={step.href} class="learning-path__link" aria-label={`Go to ${step.label}`}>
            <div class="learning-path__node" aria-current={isActive ? 'step' : undefined}>
              <span class="learning-path__icon" aria-hidden="true"><Icon name={step.icon} size={22} /></span>
              {isCompleted && <span class="learning-path__check" aria-hidden="true"><Icon name="check" size={22} /></span>}
            </div>
            <div class="learning-path__labels">
              <span class="learning-path__label">{step.label}</span>
              <span class="learning-path__desc">{step.desc}</span>
            </div>
          </a>
          {i < steps.length - 1 && <div class="learning-path__connector" aria-hidden="true"></div>}
        </li>
      )
    })}
  </ol>
</nav>

<style>
  .learning-path {
    margin: var(--space-6) 0;
    width: 100%;
    max-width: 100%;
    overflow-x: auto;
    padding: var(--space-2) var(--space-1);
    scrollbar-width: thin;
  }

  .learning-path__steps {
    display: flex;
    align-items: flex-start;
    gap: 0;
    min-width: max-content;
    padding: var(--space-2) 0;
    -webkit-overflow-scrolling: touch;
  }

  .learning-path__step {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-2);
    flex: 0 0 auto;
    min-width: 120px;
    position: relative;
  }

  .learning-path__link {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-2);
    text-decoration: none;
    color: inherit;
    padding: var(--space-2);
    border-radius: var(--radius);
    transition: all var(--duration-base) var(--ease-spring-gentle);
  }

  .learning-path__link:hover {
    transform: translateY(-4px);
  }

  .learning-path__link:hover .learning-path__node {
    transform: scale(1.1);
    box-shadow: var(--shadow-lg);
    border-color: var(--color-primary);
  }

  .learning-path__link:focus-visible {
    outline: 2px solid var(--color-primary);
    outline-offset: 4px;
  }

  .learning-path__node {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 56px;
    height: 56px;
    border-radius: 50%;
    background: var(--color-container);
    border: 2px solid var(--color-border);
    color: var(--color-text-muted);
    line-height: 1;
    transition: all var(--duration-base) var(--ease-out);
    position: relative;
    z-index: 2;
  }

  .learning-path__step--completed .learning-path__node {
    background: var(--color-success);
    border-color: var(--color-success);
    color: white;
  }

  .learning-path__step--active .learning-path__node {
    background: var(--color-primary);
    border-color: var(--color-primary);
    color: white;
    box-shadow: 0 0 0 4px var(--color-primary-fixed);
    transform: scale(1.1);
  }

  .learning-path__icon {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .learning-path__check {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.25rem;
    font-weight: 700;
    color: white;
  }

  .learning-path__labels {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.15em;
    text-align: center;
  }

  .learning-path__label {
    font-size: var(--text-body-sm);
    font-weight: 600;
    color: var(--color-text);
    white-space: nowrap;
  }

  .learning-path__desc {
    font-size: var(--text-caption);
    color: var(--color-text-muted);
    white-space: nowrap;
  }

  .learning-path__step--active .learning-path__label {
    color: var(--color-primary);
  }

  .learning-path__step--completed .learning-path__label {
    color: var(--color-success);
  }

  .learning-path__connector {
    position: absolute;
    top: 28px;
    right: -50%;
    width: 100%;
    height: 2px;
    background: var(--color-border);
    z-index: 1;
  }

  .learning-path__step--completed + .learning-path__step .learning-path__connector {
    background: var(--color-success);
  }

  .learning-path__step:last-child .learning-path__connector {
    display: none;
  }

  @media (max-width: 760px) {
    .learning-path__step { min-width: 100px; }
    .learning-path__node { width: 48px; height: 48px; font-size: 1.25rem; }
    .learning-path__label { font-size: 0.75rem; }
    .learning-path__desc { font-size: 0.65rem; }
  }

  @media (max-width: 480px) {
    .learning-path__steps {
      display: flex;
      flex-wrap: nowrap;
      overflow-x: auto;
      -webkit-overflow-scrolling: touch;
      gap: var(--space-2);
      padding: var(--space-2) var(--space-1);
    }
    .learning-path__step { 
      min-width: 85px; 
      flex: 0 0 auto;
    }
    .learning-path__connector {
      display: none;
    }
    .learning-path__label { font-size: 0.65rem; }
    .learning-path__desc { font-size: 0.55rem; }
    .learning-path__node { width: 40px; height: 40px; font-size: 1rem; }
  }
</style>