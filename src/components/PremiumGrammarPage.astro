---
// PremiumGrammarPage — Premium grammar page template using new design system
// Replaces GrammarTopicPage with GrammarPattern + interactive practice

import Learn from '../layouts/Learn.astro';
import GrammarPattern from '../components/learning/GrammarPattern.astro';
import ExampleSentence from '../components/learning/ExampleSentence.astro';
import QuickPractice from '../components/QuickPractice.astro';
import MistakeTable from '../components/MistakeTable.astro';
import AppCTA from '../components/AppCTA.astro';
import RelatedContent from '../components/RelatedContent.astro'
import PracticeCTA from '../components/learning/PracticeCTA.astro'
import RelatedLessons from '../components/layout/RelatedLessons.astro'
import SectionNav from '../components/layout/SectionNav.astro'
import { relatedFor, type SeoPage, FAMILY_BASE, FAMILY_LABEL } from '../lib/seo';
import { siteUrl } from '../lib/site';

type Props = { page: SeoPage };
const { page } = Astro.props;

const related = relatedFor(page);
const metaBits = [
  `Grammar: ${page.title}`,
  ...(page.units?.length ? [page.units.length > 1 ? `Units ${page.units.join(', ')}` : `Unit ${page.units[0]}`] : []),
];

const navSections = [
  { id: 'objective-title', label: 'What you will learn' },
  ...(page.pattern ? [{ id: 'pattern-title', label: 'The pattern' }] : []),
  ...((page.examples ?? []).length ? [{ id: 'examples-title', label: 'Examples' }] : []),
  ...((page.mistakes ?? []).length ? [{ id: 'mistakes-title', label: 'Common mistakes' }] : []),
  ...(page.practice ? [{ id: 'practice-title', label: 'Practice' }] : []),
  ...((page.faq ?? []).length ? [{ id: 'faq-title', label: 'FAQ' }] : []),
];
---

<Learn
  title={page.title}
  h1={page.h1 ?? page.title}
  description={page.description}
  kicker={FAMILY_LABEL[page.family]}
  crumbs={[
    { label: FAMILY_LABEL[page.family], href: siteUrl(FAMILY_BASE[page.family]) },
    { label: page.title, href: siteUrl(`${FAMILY_BASE[page.family]}${page.slug}/`) },
  ]}
  canonicalPath={`${FAMILY_BASE[page.family]}${page.slug}/`}
  about={[page.primaryKeyword, ...page.secondaryKeywords].join('; ')}
  meta={metaBits}
  faq={page.faq ?? []}
>
  <!-- SECTION NAV — jump to section (sticky) -->
  <SectionNav sections={navSections} label="On this page" />

  <!-- LEARNING OBJECTIVE -->
  <section class="lesson-objective" aria-labelledby="objective-title">
    <h2 id="objective-title" class="kicker">What you will learn</h2>
    <div class="prose">
      {page.intro.map((para) => <p>{para}</p>)}
      {page.tip && <p class="tip"><strong>Tip:</strong> {page.tip}</p>}
    </div>
  </section>

  <!-- GRAMMAR PATTERN -->
  {page.pattern && (
    <section class="core-lesson" aria-labelledby="pattern-title">
      <header class="lesson-header">
        <h2 id="pattern-title">The Pattern</h2>
      </header>
      <GrammarPattern
        pattern={page.pattern.marathi}
        patternHindi={page.pattern.hindi}
        patternEnglish={page.pattern.english}
        examples={page.pattern.examples ?? []}
        slots={page.pattern.slots ?? []}
        showTryIt={true}
      />
    </section>
  )}

  <!-- EXAMPLE SENTENCES -->
  {(page.examples ?? []).length > 0 && (
    <section class="core-lesson" aria-labelledby="examples-title">
      <header class="lesson-header">
        <h2 id="examples-title">Examples</h2>
      </header>
      <div class="example-grid">
        {page.examples.map((ex) => (
          <ExampleSentence
            marathi={ex.marathi}
            hindi={ex.hindi}
            english={ex.english}
            audio={ex.audio}
          />
        ))}
      </div>
    </section>
  )}

  <!-- ADDITIONAL SECTIONS -->
  {(page.sections ?? []).map((s) => (
    <section>
      <h2>{s.heading}</h2>
      {s.paragraphs.map((para) => <p>{para}</p>)}
    </section>
  ))}

  <!-- COMMON MISTAKES -->
  <div id="mistakes-title">
    <MistakeTable mistakes={page.mistakes ?? []} />
  </div>

  <!-- QUICK PRACTICE -->
  {page.practice && (
    <div id="practice-title">
      <QuickPractice practice={page.practice} />
    </div>
  )}

  <!-- PRACTICE CTA - Contextual app bridge -->
  <PracticeCTA variant="grammar" context={`grammar-${page.slug}`} />

  <!-- RELATED LESSONS -->
  <RelatedLessons links={related} max={4} title="Continue learning" />

  <!-- FAQ -->
  {(page.faq ?? []).length > 0 && (
    <>
      <h2 id="faq-title">Common questions</h2>
      {page.faq!.map((f) => (
        <details>
          <summary>{f.question}</summary>
          <p>{f.answer}</p>
        </details>
      ))}
    </>
  )}
</Learn>

<style>
  /* Anchor clearance for the sticky section nav */
  #objective-title,
  #pattern-title,
  #examples-title,
  #mistakes-title,
  #practice-title,
  #faq-title { scroll-margin-top: 5.5rem; }

  .lesson-objective {
    margin: var(--space-6) 0;
    padding: var(--space-5);
    background: var(--color-container-low);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
  }

  .lesson-objective .kicker { margin-bottom: var(--space-2); }

  .core-lesson { margin: var(--space-6) 0; }

  .lesson-header {
    margin-bottom: var(--space-4);
  }

  .lesson-header h2 { margin: 0; font-size: var(--text-h2); }

  .example-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: var(--space-4);
  }

  details {
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    background: var(--color-surface);
    padding: var(--space-3) var(--space-4);
    margin-bottom: var(--space-3);
  }

  details summary {
    font-weight: 600;
    cursor: pointer;
  }

  details p { margin: var(--space-2) 0 0 0; }
</style>