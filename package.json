{
  "name": "learn-marathi",
  "type": "module",
  "version": "0.1.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "prebuild": "node ./tools/validate-content.mjs && node --experimental-strip-types ./tools/validate-games.mts && node ./tools/build-search-index.mjs",
    "build": "astro build",
    "preview": "astro preview",
    "test": "node --test --experimental-strip-types \"tests/*.test.ts\"",
    "astro": "astro",
    "sync": "node ./tools/sync-learn-marathi.mjs",
    "qa": "node ./tools/qa.mjs",
    "content:qa": "node ./tools/validate-content.mjs",
    "content:manifest": "node ./tools/content-manifest.mjs",
    "content:og": "node ./tools/make-og-pages.mjs",
    "content:report": "node ./tools/content-report.mjs",
    "audit:images": "node ./tools/audit-images.mjs",
    "hero:audit": "node ./tools/hero-audit.mjs",
    "og:social": "node ./tools/optimize-og-social.mjs",
    "og:check": "node ./tools/check-og-resolve.mjs"
  },
  "dependencies": {
    "@astrojs/mdx": "^8.0.0",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "astro": "^7.3.1",
    "idb": "^8.0.0",
    "sharp": "^0.35.0"
  },
  "allowScripts": {
    "esbuild": true
  },
  "devDependencies": {
    "playwright": "^1.63.0"
  }
}
